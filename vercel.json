{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd artifacts/web && vite build --config vite.config.ts",
  "outputDirectory": "artifacts/web/dist/public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!favicon\\.svg|assets/).*)", "destination": "/index.html" }
  ]
}
