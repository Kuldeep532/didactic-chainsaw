---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Nexus Admin — Content Center</title>
<style>
  :root {
    color-scheme: light;
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface-soft: #f1f5f9;
    --text: #172033;
    --muted: #5f6b7a;
    --border: #d9e1ec;
    --border-strong: #b8c5d6;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-active: #1e40af;
    --primary-soft: #dbeafe;
    --on-primary: #ffffff;
    --danger: #b42318;
    --shadow-1: 0 1px 2px rgb(15 23 42 / 6%), 0 4px 12px rgb(15 23 42 / 4%);
    --shadow-2: 0 4px 8px rgb(15 23 42 / 7%), 0 12px 28px rgb(15 23 42 / 7%);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-12: 48px;
    --font: Inter, Roboto, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  html[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0b1220;
    --surface: #111a2b;
    --surface-soft: #131e31;
    --text: #f3f6fc;
    --muted: #b1bdd0;
    --border: #2a3950;
    --border-strong: #3b4d67;
    --primary: #75a9ff;
    --primary-hover: #91bbff;
    --primary-active: #b1ceff;
    --primary-soft: #18345d;
    --on-primary: #08111f;
    --danger: #ff9187;
    --shadow-1: 0 1px 2px rgb(0 0 0 / 22%), 0 4px 12px rgb(0 0 0 / 15%);
    --shadow-2: 0 4px 10px rgb(0 0 0 / 24%), 0 12px 28px rgb(0 0 0 / 20%);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--bg);
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-width: 320px;
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.55;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--text);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  h2 { font-size: 1.5rem; }
  h3 { font-size: 1.125rem; }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--primary) 28%, transparent);
    outline-offset: 2px;
  }

  .wrap {
    width: min(calc(100% - 32px), 1120px);
    margin-inline: auto;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
  }

  .card {
    min-width: 0;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-1);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-2);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .form {
    display: grid;
    gap: var(--space-4);
  }

  .form label {
    display: grid;
    gap: var(--space-2);
    color: var(--text);
    font-size: .875rem;
    font-weight: 650;
  }

  .form input,
  .form textarea,
  .form select {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    color: var(--text);
    line-height: 1.45;
    transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .form input:hover,
  .form textarea:hover,
  .form select:hover {
    border-color: var(--border-strong);
  }

  .form input:focus-visible,
  .form textarea:focus-visible,
  .form select:focus-visible {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
    outline: none;
  }

  .form textarea {
    min-height: 136px;
    resize: vertical;
  }

  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: .875rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .button:hover {
    border-color: var(--border-strong);
    background: var(--surface-soft);
    transform: translateY(-1px);
    box-shadow: var(--shadow-1);
  }

  .button:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .primary {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--on-primary);
  }

  .primary:hover {
    border-color: var(--primary-hover);
    background: var(--primary-hover);
  }

  .danger {
    color: var(--danger);
  }

  .status {
    min-height: 26px;
    color: var(--muted);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .item {
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  .item-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .muted {
    color: var(--muted);
  }

  [hidden] {
    display: none !important;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .wrap {
      width: min(calc(100% - 24px), 1120px);
    }

    .top {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-4);
    }

    .card {
      padding: var(--space-5);
    }

    .item-head {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
</style>
</head>
<body>
<div class="wrap">
<header class="top"><div><p class="muted" style="margin:0">Nexus Admin</p><h1 style="margin:.2rem 0">Content Center</h1><p class="muted" style="margin:0">Publish posts and add useful links without editing the website code.</p></div><button id="theme" class="button" type="button">Change theme</button></header>
<p id="status" class="status" aria-live="polite">Checking your account…</p>
<section id="login-panel" class="card" hidden><h2>Admin sign in</h2><p class="muted">Sign in with an approved administrator account.</p><form id="login-form" class="form"><label>Email<input id="email" type="email" autocomplete="email" required /></label><label>Password<input id="password" type="password" autocomplete="current-password" required /></label><button class="button primary" type="submit">Sign in</button></form><p id="login-status" class="status" aria-live="polite"></p></section>
<section id="admin-panel" hidden>
<div class="card"><div class="item-head"><div><strong id="identity">Administrator</strong><p class="muted" style="margin:.2rem 0">Only approved admin accounts can publish or change website content.</p></div><button id="sign-out" class="button" type="button">Sign out</button></div></div>
<div class="grid">
<article class="card"><h2>Publish a post</h2><p class="muted">Write a title and message. Turn on “Publish now” to make it visible on the Posts page.</p><form id="post-form" class="form"><label>Title<input id="post-title" maxlength="160" required /></label><label>Category<input id="post-category" maxlength="60" value="Nexus" /></label><label>Short description<textarea id="post-excerpt" maxlength="400" required></textarea></label><label>Post content<textarea id="post-body" minlength="1" required></textarea></label><label>Web address (optional)<input id="post-slug" placeholder="my-new-post" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" /></label><label style="display:flex;gap:8px;align-items:center"><input id="post-published" type="checkbox" checked /> Publish now</label><button class="button primary" type="submit">Save post</button></form><p id="post-status" class="status" aria-live="polite"></p></article>
<article class="card"><h2>Add a useful link</h2><p class="muted">Choose the screen. Nexus will place the link in that screen’s “More to explore” area automatically, without changing the page layout.</p><form id="link-form" class="form"><label>Screen<select id="link-screen"><option value="home">Home</option><option value="apps">Apps & Services</option><option value="women-safety">Women Safety</option><option value="posts">Posts</option><option value="community">Community</option><option value="join-team">Join Team</option><option value="footer">Footer</option><option value="all">Everywhere</option></select></label><label>Link text<input id="link-label" maxlength="100" required placeholder="Open Nexus Plus" /></label><label>URL<input id="link-url" type="url" required placeholder="https://example.com" /></label><label>Short description<input id="link-description" maxlength="240" placeholder="A short explanation for visitors" /></label><button class="button primary" type="submit">Add link</button></form><p id="link-status" class="status" aria-live="polite"></p></article>
</div>
<div class="grid"><section class="card"><h2>Recent posts</h2><div id="post-list" class="list"></div></section><section class="card"><h2>Website links</h2><div id="link-list" class="list"></div></section></div>
</section>
</div>
<script type="module" is:inline>
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.57.4";
const url=${JSON.stringify(supabaseUrl)},key=${JSON.stringify(supabaseKey)};
const supabase=url&&key?createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}}):null;
const status=document.getElementById("status"),loginPanel=document.getElementById("login-panel"),adminPanel=document.getElementById("admin-panel");
const friendly=(error)=>{const m=String(error?.message??"").toLowerCase();if(m.includes("invalid login"))return "Email or password is incorrect.";if(m.includes("permission")||m.includes("row-level"))return "You do not have permission to make that change.";if(m.includes("duplicate"))return "That post address is already in use.";return "Something went wrong. Please check the details and try again.";};
const makeSlug=(value)=>value.toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"").slice(0,80);
async function loadLists(){
 if(!supabase)return;
 const [{data:posts},{data:links}]=await Promise.all([supabase.from("site_posts").select("id,title,category,excerpt,published,created_at,slug").order("created_at",{ascending:false}).limit(12),supabase.from("site_links").select("id,screen,label,url,active,created_at").order("created_at",{ascending:false}).limit(20)]);
 const postList=document.getElementById("post-list");postList.replaceChildren();
 for(const p of posts??[]){const item=document.createElement("div");item.className="item";const head=document.createElement("div");head.className="item-head";const left=document.createElement("div");const title=document.createElement("strong");title.textContent=p.title;const meta=document.createElement("div");meta.className="muted";meta.textContent=(p.category||"Nexus")+" · "+(p.published?"Published":"Saved for later");left.append(title,meta);const btn=document.createElement("button");btn.className="button danger";btn.textContent="Delete";btn.onclick=async()=>{if(!confirm("Delete this post?"))return;const {error}=await supabase.from("site_posts").delete().eq("id",p.id);if(error)alert(friendly(error));else loadLists();};head.append(left,btn);item.append(head);postList.append(item);}
 if(!posts?.length)postList.innerHTML='<p class="muted">No posts yet.</p>';
 const linkList=document.getElementById("link-list");linkList.replaceChildren();
 for(const l of links??[]){const item=document.createElement("div");item.className="item";const head=document.createElement("div");head.className="item-head";const left=document.createElement("div");const title=document.createElement("strong");title.textContent=l.label;const meta=document.createElement("div");meta.className="muted";meta.textContent=(l.screen==="all"?"Everywhere":l.screen)+" · "+(l.active?"Visible":"Hidden");left.append(title,meta);const btn=document.createElement("button");btn.className="button danger";btn.textContent="Delete";btn.onclick=async()=>{if(!confirm("Remove this link?"))return;const {error}=await supabase.from("site_links").delete().eq("id",l.id);if(error)alert(friendly(error));else loadLists();};head.append(left,btn);item.append(head);linkList.append(item);}
 if(!links?.length)linkList.innerHTML='<p class="muted">No links yet.</p>';
}
async function renderSession(session){
 if(!supabase){status.textContent="The admin sign-in is not ready yet. Add the website settings and try again.";loginPanel.hidden=false;adminPanel.hidden=true;return;}
 if(!session){status.textContent="Please sign in to continue.";loginPanel.hidden=false;adminPanel.hidden=true;return;}
 const {data:profile,error}=await supabase.from("profiles").select("user_id,full_name,role").eq("user_id",session.user.id).maybeSingle();
 if(error||profile?.role!=="admin"){await supabase.auth.signOut();status.textContent="This account does not have admin access.";loginPanel.hidden=false;adminPanel.hidden=true;return;}
 status.textContent="You are signed in.";document.getElementById("identity").textContent=profile.full_name||session.user.email||"Administrator";loginPanel.hidden=true;adminPanel.hidden=false;loadLists();
}
supabase?.auth.onAuthStateChange((_event,session)=>{void renderSession(session);});supabase?.auth.getSession().then(({data})=>renderSession(data.session));
document.getElementById("login-form").addEventListener("submit",async e=>{e.preventDefault();const out=document.getElementById("login-status");out.textContent="Signing you in…";if(!supabase){out.textContent="Admin sign-in is not ready yet.";return;}const {error}=await supabase.auth.signInWithPassword({email:document.getElementById("email").value.trim(),password:document.getElementById("password").value});if(error)out.textContent=friendly(error);});
document.getElementById("sign-out").addEventListener("click",async()=>{await supabase?.auth.signOut();});
document.getElementById("post-form").addEventListener("submit",async e=>{e.preventDefault();const out=document.getElementById("post-status");out.textContent="Saving your post…";const {data:{user}}=await supabase.auth.getUser();if(!user){out.textContent="Please sign in again.";return;}const title=document.getElementById("post-title").value.trim(),slug=makeSlug(document.getElementById("post-slug").value||title);const {error}=await supabase.from("site_posts").insert({title,slug,category:document.getElementById("post-category").value.trim()||"Nexus",excerpt:document.getElementById("post-excerpt").value.trim(),body:document.getElementById("post-body").value.trim(),published:document.getElementById("post-published").checked,created_by:user.id});if(error){out.textContent=friendly(error);return;}out.textContent="Post saved. Open the Posts page to see it.";e.target.reset();document.getElementById("post-published").checked=true;loadLists();});
document.getElementById("link-form").addEventListener("submit",async e=>{e.preventDefault();const out=document.getElementById("link-status");out.textContent="Adding your link…";const {data:{user}}=await supabase.auth.getUser();if(!user){out.textContent="Please sign in again.";return;}const {error}=await supabase.from("site_links").insert({screen:document.getElementById("link-screen").value,label:document.getElementById("link-label").value.trim(),url:document.getElementById("link-url").value.trim(),description:document.getElementById("link-description").value.trim(),created_by:user.id});if(error){out.textContent=friendly(error);return;}out.textContent="Link added. It will appear automatically in the selected screen.";e.target.reset();loadLists();});
document.getElementById("theme").addEventListener("click",()=>{const dark=document.documentElement.dataset.theme==="dark";document.documentElement.dataset.theme=dark?"light":"dark";localStorage.setItem("nexus-admin-theme",dark?"light":"dark");});try{document.documentElement.dataset.theme=localStorage.getItem("nexus-admin-theme")||"light";}catch{}
</script>
</body></html>
