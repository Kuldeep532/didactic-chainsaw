---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Tools — Nexus Wave Technologies" description="Private browser tools for everyday tasks.">
  <section class="hero tools-hero"><div class="container"><p class="eyebrow">Tools</p><h1>Simple tools for everyday tasks.</h1><p class="lead">Choose a tool below. Your work stays in your browser, with no account needed for these tools.</p></div></section>
  <section class="section"><div class="container">
    <a class="button ghost page-back" href="/">← Back to Home</a>
    <div class="section-head"><div><p class="eyebrow">All tools</p><h2>Choose a tool</h2><p class="muted">Every tool is shown here so you can find what you need quickly.</p></div></div>
    <div class="grid-3">
      <article class="card tool-card"><p class="eyebrow">QR</p><h3>QR Code Generator</h3><p class="muted">Create QR codes for text, Wi‑Fi and UPI.</p><a class="button primary" href="/tools/qr-code-generator">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Text</p><h3>Text Counter</h3><p class="muted">Count words, characters, lines and reading time.</p><a class="button" href="/tools/text-counter">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Text</p><h3>Text Formatter</h3><p class="muted">Clean up and transform text with useful formatting options.</p><a class="button" href="/tools/text-formatter">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Documents</p><h3>Document Converter</h3><p class="muted">Prepare supported text files locally in your browser.</p><a class="button" href="/tools/document-converter">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Images</p><h3>Image Compressor</h3><p class="muted">Reduce image file size directly on your device.</p><a class="button" href="/tools/image-compressor">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Data</p><h3>JSON Formatter</h3><p class="muted">Format and check JSON without uploading it.</p><a class="button" href="/tools/json-formatter">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Web</p><h3>URL Encoder & Decoder</h3><p class="muted">Encode or decode URL text privately in your browser.</p><a class="button" href="/tools/url-encoder">Open tool</a></article>
      <article class="card tool-card"><p class="eyebrow">Data</p><h3>Base64 Encoder & Decoder</h3><p class="muted">Convert text to and from Base64 on your device.</p><a class="button" href="/tools/base64">Open tool</a></article>
    </div>
  </div></section>
  <style>.tools-hero{padding-bottom:40px}.page-back{margin-bottom:22px}.tool-card{display:grid;gap:10px}.tool-card .button{width:max-content;max-width:100%}</style>
</Layout>