---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tools — Nexus Wave Technologies" description="Useful browser tools that work without a third-party API.">
  <section class="hero tools-hero">
    <div class="container">
      <p class="eyebrow">Tools</p>
      <h1>Practical tools for everyday tasks.</h1>
      <p class="lead">Fast, private, browser-based tools. No account or third-party API is required for the tools on this page.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <nav class="tool-tabs" aria-label="Tool categories">
        <a href="/tools/qr-code-generator">QR Code Generator</a>
        <a href="/tools/text-counter">Text Counter</a>
        <a href="/tools/text-formatter">Text Formatter</a>
        <a href="/tools/password-generator">Password Generator</a>
        <a href="/tools/image-compressor">Image Compressor</a>
      </nav>

      <div class="section-head">
        <div>
          <p class="eyebrow">All tools</p>
          <h2>Choose a tool</h2>
          <p class="muted">Each tool opens on its own screen so the task stays focused and easy to navigate.</p>
        </div>
      </div>

      <div class="grid-3">
        <article class="card tool-card"><div class="tool-card-mark" aria-hidden="true"></div><p class="eyebrow">QR</p><h3>QR Code Generator</h3><p class="muted">Create scannable QR codes for text, Wi‑Fi and UPI.</p><a class="button primary" href="/tools/qr-code-generator">Open tool</a></article>
        <article class="card tool-card"><div class="tool-card-mark tool-card-mark--blue" aria-hidden="true"></div><p class="eyebrow">Text</p><h3>Text Counter</h3><p class="muted">Count words, characters, lines and reading time instantly.</p><a class="button" href="/tools/text-counter">Open tool</a></article>
        <article class="card tool-card"><div class="tool-card-mark tool-card-mark--violet" aria-hidden="true"></div><p class="eyebrow">Text</p><h3>Text Formatter</h3><p class="muted">Clean and transform text with common formatting options.</p><a class="button" href="/tools/text-formatter">Open tool</a></article>
        <article class="card tool-card"><div class="tool-card-mark tool-card-mark--green" aria-hidden="true"></div><p class="eyebrow">Security</p><h3>Password Generator</h3><p class="muted">Create strong random passwords locally in your browser.</p><a class="button" href="/tools/password-generator">Open tool</a></article>
        <article class="card tool-card"><div class="tool-card-mark tool-card-mark--amber" aria-hidden="true"></div><p class="eyebrow">Images</p><h3>Image Compressor</h3><p class="muted">Reduce image file size directly on your device.</p><a class="button" href="/tools/image-compressor">Open tool</a></article>
      </div>
    </div>
  </section>

  <style>
    .tools-hero{padding-bottom:40px}.tool-tabs{display:flex;gap:8px;overflow:auto;padding:4px 0 18px;scroll-snap-type:x proximity}.tool-tabs a{flex:0 0 auto;padding:10px 14px;border:1px solid var(--color-border);border-radius:999px;text-decoration:none;color:var(--color-text);background:var(--color-surface);scroll-snap-align:start}.tool-tabs a:hover{background:var(--color-surface-soft);color:var(--color-text)}.tool-card{display:grid;gap:10px}.tool-card-mark{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#111827,#2563eb)}.tool-card-mark--blue{background:linear-gradient(135deg,#2563eb,#0ea5e9)}.tool-card-mark--violet{background:linear-gradient(135deg,#4f46e5,#7c3aed)}.tool-card-mark--green{background:linear-gradient(135deg,#047857,#16a34a)}.tool-card-mark--amber{background:linear-gradient(135deg,#b45309,#d97706)}
  </style>
</Layout>