---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Resource Center — Women Safety" description="Official women-safety resources and support services.">
  <section class="hero"><div class="container"><p class="eyebrow">Women Safety</p><h1>Resource Center</h1><p class="lead">Official routes for legal help, shelter, workplace safety, cyber crime and support services.</p></div></section>
  <section class="section"><div class="container grid-3">
    <article class="card"><h2>One Stop Centre</h2><p class="muted">Integrated medical, legal, police, temporary shelter and counselling support for women affected by violence.</p><a class="button" href="https://wcd.gov.in/women/one-stop-centre-header" target="_blank" rel="noopener noreferrer">Official information</a></article>
    <article class="card"><h2>Free legal aid</h2><p class="muted">NALSA and State Legal Services Authorities provide legal-aid pathways. The national legal-aid helpline is 15100.</p><a class="button" href="tel:15100">Call 15100</a></article>
    <article class="card"><h2>Shakti Sadan</h2><p class="muted">Shelter and longer-term support for women in distress and difficult circumstances.</p><a class="button" href="https://wcd.gov.in/offerings/shakti-sadan" target="_blank" rel="noopener noreferrer">Official information</a></article>
    <article class="card"><h2>SHe-Box</h2><p class="muted">Official workplace sexual-harassment complaint and information route.</p><a class="button" href="https://shebox.wcd.gov.in/" target="_blank" rel="noopener noreferrer">Open SHe-Box</a></article>
    <article class="card"><h2>Cyber Crime Portal</h2><p class="muted">Report cyber crime through the official national portal.</p><a class="button" href="https://www.cybercrime.gov.in/" target="_blank" rel="noopener noreferrer">Open portal</a></article>
    <article class="card"><h2>Women and law</h2><p class="muted">Official information about laws and protections covering women and children.</p><a class="button" href="https://wcd.gov.in/women/legislations" target="_blank" rel="noopener noreferrer">View official information</a></article>
  </div></section>
</Layout>