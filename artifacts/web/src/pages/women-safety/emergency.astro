---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Emergency Help — Women Safety" description="Emergency contacts and official urgent-help routes.">
  <section class="hero"><div class="container"><p class="eyebrow">Women Safety</p><h1>Emergency Help</h1><p class="lead">When danger is happening now, get immediate help first. Do not wait for a website report.</p></div></section>
  <section class="section"><div class="container grid-4">
    <article class="card"><span class="resource-number">112</span><h2>Emergency response</h2><p class="muted">Pan-India emergency response for police, fire, medical and other urgent assistance.</p><a class="button primary" href="tel:112">Call 112</a><a class="text-link" href="https://112.gov.in/" target="_blank" rel="noopener noreferrer">Official website</a></article>
    <article class="card"><span class="resource-number">181</span><h2>Women Helpline</h2><p class="muted">Women-focused support, information and referrals.</p><a class="button primary" href="tel:181">Call 181</a><a class="text-link" href="https://wcd.gov.in/women/help" target="_blank" rel="noopener noreferrer">Official information</a></article>
    <article class="card"><span class="resource-number">1930</span><h2>Cyber crime</h2><p class="muted">For cyber incidents, including urgent cyber financial fraud reporting.</p><a class="button primary" href="tel:1930">Call 1930</a><a class="text-link" href="https://www.cybercrime.gov.in/" target="_blank" rel="noopener noreferrer">Open portal</a></article>
    <article class="card"><span class="resource-number">1098</span><h2>Child Helpline</h2><p class="muted">For children who need protection or assistance.</p><a class="button primary" href="tel:1098">Call 1098</a><a class="text-link" href="https://www.spniwcd.wcd.gov.in/" target="_blank" rel="noopener noreferrer">Official resources</a></article>
  </div></section>
</Layout>
<style>.resource-number{display:block;font-size:2rem;font-weight:850;color:var(--color-primary);margin-bottom:8px}.text-link{display:inline-block;margin-top:12px;font-weight:700}</style>