---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Anonymous Forum — Nexus Community" description="A privacy-first anonymous forum for sharing ideas without exposing personal information.">
  <section class="hero"><div class="container hero-shell">
    <div><p class="eyebrow">Nexus Community</p><h1>Share an idea without turning it into a social profile.</h1><p class="lead">This forum is intentionally different from social media. Posts are published under an anonymous display identity, and the form blocks common requests for personal or private information.</p></div>
    <div class="hero-panel"><p class="eyebrow">Privacy</p><h2>No public email, phone or profile page.</h2><p class="muted">Moderation can still remove abuse or unsafe content, but ordinary readers do not need to know who submitted a post.</p></div>
  </div></section>
  <section class="section"><div class="container grid-2">
    <article class="card">
      <p class="eyebrow">Anonymous form</p><h2>Share your thoughts</h2>
      <form id="anon-form" class="form">
        <label>Topic<select id="topic"><option>Idea</option><option>Suggestion</option><option>Accessibility</option><option>Product feedback</option><option>Community improvement</option><option>General thought</option></select></label>
        <label>Your message<textarea id="message" minlength="20" maxlength="4000" required placeholder="Write what you want to share…"></textarea></label>
        <label class="checkbox-row"><input id="confirm" type="checkbox" required /> I am not sharing another person's private information, passwords, phone numbers, addresses, financial data or secret credentials.</label>
        <button class="button primary" type="submit">Submit anonymously</button>
        <p id="status" class="note" aria-live="polite"></p>
      </form>
    </article>
    <article class="card">
      <p class="eyebrow">What is blocked?</p><h2>Private-data protection</h2>
      <ul class="feature-list">
        <li>Email addresses, phone numbers and home addresses.</li>
        <li>Passwords, OTPs, API keys, payment information and account credentials.</li>
        <li>Private medical, legal, intimate or identifying information about another person.</li>
        <li>Requests to reveal another user's identity.</li>
      </ul>
      <p class="note">Anonymous does not mean unmoderated. The service may reject or remove abuse, threats, illegal content, spam and targeted harassment.</p>
    </article>
  </div></section>
  <section class="section surface-soft"><div class="container grid-3">
    <article class="card"><h3>Encrypted transport</h3><p class="muted">The form is delivered over HTTPS/TLS.</p></article>
    <article class="card"><h3>Minimal metadata</h3><p class="muted">The public post should not expose email, phone or ordinary account profile information.</p></article>
    <article class="card"><h3>Moderated, not social</h3><p class="muted">No follower counts, likes, public friend graph or profile-driven popularity system.</p></article>
  </div></section>
  <script is:inline>
    const form=document.getElementById("anon-form"), msg=document.getElementById("message"), status=document.getElementById("status");
    const blocked=[/\b\d{10}\b/,/\b(?:upi|ifsc|otp|password|api[ -]?key|cvv|pin)\b/i,/\b(?:gmail|outlook|yahoo)\.com\b/i,/https?:\/\//i];
    form.addEventListener("submit",(e)=>{
      e.preventDefault();
      const text=msg.value.trim();
      if(blocked.some(rx=>rx.test(text))){ status.textContent="Please remove personal, credential, payment or private-contact information before submitting."; return; }
      status.textContent="The anonymous submission is ready for the protected moderation endpoint.";
    });
  </script>
</Layout>