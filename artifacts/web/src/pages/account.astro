---
import Layout from "../layouts/Layout.astro";
---
<Layout title="My Account — Nexus Wave Technologies" description="Manage your Nexus account and private services.">
  <section class="hero"><div class="container"><p class="eyebrow">My account</p><h1>Everything important, in one place.</h1><p class="lead">Manage your account, notifications and private support access without exposing personal details publicly.</p></div></section>
  <section class="section"><div class="container grid-3">
    <article class="card"><p class="eyebrow">Account</p><h3 id="account-name">Your Nexus account</h3><p id="account-email" class="muted">Loading your account…</p></article>
    <article class="card"><p class="eyebrow">Notifications</p><h3>Stay up to date</h3><p class="muted">See important updates and support messages.</p><a class="button" href="/notifications">View notifications</a></article>
    <article class="card"><p class="eyebrow">Women Safety</p><h3>Private support</h3><p class="muted">Open the safety center when you need to report a concern or find support information.</p><a class="button primary" href="/women-safety">Open Women Safety</a></article>
  </div></section>
  <section class="section surface-soft"><div class="container"><div class="card"><h2>Sign out</h2><p class="muted">You can sign out from this device at any time.</p><button id="signout" class="button" type="button">Sign out</button><p id="status" class="note" aria-live="polite"></p></div></div></section>
</Layout>

<script>
  import { browserSupabase } from "../lib/browser-auth";

  const nameEl=document.getElementById("account-name"),emailEl=document.getElementById("account-email"),status=document.getElementById("status");
  const showSession=async(session)=>{
    if(!session){location.href="/login";return;}
    emailEl.textContent=session.user.email||"Account email";
    nameEl.textContent=session.user.user_metadata?.full_name||"Your Nexus account";
    if(browserSupabase){
      const {data}=await browserSupabase.from("profiles").select("full_name").eq("user_id",session.user.id).maybeSingle();
      if(data?.full_name)nameEl.textContent=data.full_name;
    }
  };
  browserSupabase?.auth.onAuthStateChange((_event,session)=>{void showSession(session);});
  browserSupabase?.auth.getSession().then(({data})=>showSession(data.session));
  document.getElementById("signout")?.addEventListener("click",async()=>{status.textContent="Signing you out…";if(browserSupabase)await browserSupabase.auth.signOut();});
</script>
