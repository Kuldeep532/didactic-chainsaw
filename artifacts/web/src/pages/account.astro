---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Account — Nexus Wave Technologies">
  <section class="hero"><div class="container"><p class="eyebrow">Nexus account</p><h1>Your account.</h1><p class="lead">Your account session is stored locally in the browser and authenticated through Supabase.</p></div></section>
  <section class="section"><div class="container"><div class="card" style="max-width:720px;margin-inline:auto">
    <p id="account-state" class="muted">Checking session…</p>
    <div class="actions"><a class="button" href="/apps">View apps</a><button id="sign-out" class="button" type="button">Sign out</button></div>
  </div></div></section>
  <script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
    const url=supabaseUrl; const key=supabaseKey; const state=document.getElementById('account-state');
    async function load(){const token=localStorage.getItem('nexus_access_token');if(!url||!key||!token){state.textContent='No active website session was found.';return;}try{const r=await fetch(url+'/auth/v1/user',{headers:{apikey:key,Authorization:'Bearer '+token}});if(!r.ok){state.textContent='Your session has expired. Please sign in again.';return;}const u=await r.json();state.textContent='Signed in as '+(u.email||'your Nexus account')+'.';}catch{state.textContent='Could not check the account session right now.';}}
    document.getElementById('sign-out')?.addEventListener('click',async()=>{const token=localStorage.getItem('nexus_access_token');if(url&&key&&token)await fetch(url+'/auth/v1/logout',{method:'POST',headers:{apikey:key,Authorization:'Bearer '+token}}).catch(()=>{});localStorage.removeItem('nexus_access_token');localStorage.removeItem('nexus_refresh_token');state.textContent='Signed out.';});
    void load();
  </script>
</Layout>