---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Log in — Nexus Wave Technologies" description="Log in or create your Nexus account.">
  <section class="hero"><div class="container"><p class="eyebrow">Nexus account</p><h1>Welcome back.</h1><p class="lead">Sign in to keep your private services, notifications and account settings together in one place.</p></div></section>
  <section class="section"><div class="container grid-2">
    <article class="card">
      <div id="login-view"><p class="eyebrow">Sign in</p><h2>Log in to Nexus</h2>
        <button id="google-login" class="button primary" type="button" style="width:100%">Continue with Google</button>
        <div class="note" style="text-align:center;margin:14px 0">or use your email</div>
        <form id="login-form" class="form">
          <label>Email<input id="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
          <label>Password<input id="password" type="password" autocomplete="current-password" required placeholder="Your password" /></label>
          <button class="button" type="submit">Log in</button>
        </form>
        <p class="note" style="margin-top:16px">New here? <button id="show-signup" class="button ghost" type="button">Create a new account</button></p>
      </div>
      <div id="signup-view" hidden><p class="eyebrow">New account</p><h2>Create your Nexus account</h2><p class="muted">It only takes a moment. Use an email address you can access.</p>
        <form id="signup-form" class="form">
          <label>Your name<input id="signup-name" autocomplete="name" required placeholder="Your name" /></label>
          <label>Email<input id="signup-email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
          <label>Password<input id="signup-password" type="password" autocomplete="new-password" minlength="6" required placeholder="At least 6 characters" /></label>
          <button class="button primary" type="submit">Create account</button>
        </form>
        <p class="note" style="margin-top:16px">Already have an account? <button id="show-login" class="button ghost" type="button">Log in</button></p>
      </div>
      <p id="status" class="note" aria-live="polite"></p>
    </article>
    <article class="card"><p class="eyebrow">Your account, your way</p><h2>Everything you use, in one place.</h2><ul class="feature-list"><li>Keep your account and notifications together.</li><li>Use private support features when you need them.</li><li>Your public profile stays separate from private account details.</li></ul></article>
  </div></section>
</Layout>

<script>
  import { browserSupabase } from "../lib/browser-auth";
  const loginView=document.getElementById("login-view"), signupView=document.getElementById("signup-view"), status=document.getElementById("status");
  const show=(name)=>{loginView.hidden=name!=="login";signupView.hidden=name!=="signup";status.textContent="";};
  const friendlyError=(error)=>{const message=String(error?.message??"").toLowerCase();if(message.includes("invalid login"))return "Email or password is incorrect.";if(message.includes("email not confirmed"))return "Please confirm your email first, then log in.";if(message.includes("user already registered"))return "This email already has an account. Please log in.";if(message.includes("password"))return "Please choose a password with at least 6 characters.";return "We could not complete that request. Please check your details and try again.";};
  document.getElementById("show-signup")?.addEventListener("click",()=>show("signup"));
  document.getElementById("show-login")?.addEventListener("click",()=>show("login"));
  browserSupabase?.auth.onAuthStateChange((_event,session)=>{if(session)location.href="/account";});
  document.getElementById("login-form")?.addEventListener("submit",async event=>{event.preventDefault();if(!browserSupabase){status.textContent="Sign-in is temporarily unavailable. Please try again in a moment.";return;}status.textContent="Signing you in…";const {error}=await browserSupabase.auth.signInWithPassword({email:document.getElementById("email").value.trim(),password:document.getElementById("password").value});if(error)status.textContent=friendlyError(error);});
  document.getElementById("signup-form")?.addEventListener("submit",async event=>{event.preventDefault();if(!browserSupabase){status.textContent="Account creation is temporarily unavailable. Please try again in a moment.";return;}status.textContent="Creating your account…";const {data,error}=await browserSupabase.auth.signUp({email:document.getElementById("signup-email").value.trim(),password:document.getElementById("signup-password").value,options:{data:{full_name:document.getElementById("signup-name").value.trim()}}});if(error){status.textContent=friendlyError(error);return;}if(data.session)return;status.textContent="Your account is ready. Check your email to confirm it, then log in.";show("login");});
  document.getElementById("google-login")?.addEventListener("click",async()=>{if(!browserSupabase){status.textContent="Google sign-in is temporarily unavailable. Please try again in a moment.";return;}status.textContent="Opening Google sign-in…";const {error}=await browserSupabase.auth.signInWithOAuth({provider:"google",options:{redirectTo:`${window.location.origin}/account`}});if(error)status.textContent="Google sign-in could not start. Please try again.";});
</script>
