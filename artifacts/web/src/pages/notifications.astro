---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Notifications — Nexus Wave Technologies" description="Your important Nexus updates.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Notifications</p>
      <h1>Important updates, in one place.</h1>
      <p class="lead">See replies, account alerts and useful updates without searching through different pages.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-3">
      <article class="card"><p class="eyebrow">Support</p><h3>Support replies</h3><p class="muted">Know when someone has replied to a private support request.</p></article>
      <article class="card"><p class="eyebrow">Your account</p><h3>Account alerts</h3><p class="muted">Important sign-in and privacy updates can appear here.</p></article>
      <article class="card"><p class="eyebrow">Nexus</p><h3>New things</h3><p class="muted">Hear about useful app features and service updates.</p></article>
    </div>
  </section>
  <section class="section surface-soft">
    <div class="container">
      <div class="card">
        <h2>Sign in to see your personal updates.</h2>
        <p class="muted">Your private notifications are available only after you sign in.</p>
        <a class="button primary" href="/login">Log in</a>
      </div>
    </div>
  </section>
</Layout>
