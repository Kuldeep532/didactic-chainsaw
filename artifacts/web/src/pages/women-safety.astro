---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Women Safety — Nexus Wave Technologies" description="A simple, private place to find safety information and request support.">
  <section class="hero">
    <div class="container hero-shell">
      <div>
        <p class="eyebrow">Women Safety Center</p>
        <h1>You deserve to feel safe.</h1>
        <p class="lead">Find immediate help, share a concern privately, or understand what happens after you ask for support.</p>
        <div class="actions">
          <a class="button primary" href="#report">Report a concern</a>
          <a class="button" href="/safety-resources">Safety Resources</a>
          <a class="button" href="#support">How support works</a>
        </div>
      </div>
      <div class="hero-panel">
        <p class="eyebrow">If you are in immediate danger</p>
        <h2>Get emergency help first.</h2>
        <p class="muted">For an emergency in India, call 112 or contact your local emergency service.</p>
        <a class="button primary" href="tel:112">Call 112</a>
      </div>
    </div>
  </section>

  <section class="section" id="report">
    <div class="container grid-2">
      <article class="card">
        <p class="eyebrow">Private report</p>
        <h2>Tell us what happened.</h2>
        <p class="muted">A Nexus account is required so that your private request can be connected to the right support process.</p>
        <div id="login-note" class="section-card" style="margin:16px 0">
          <strong>Please log in first.</strong>
          <p class="muted">Your report will not be submitted while you are signed out.</p>
          <a class="button primary" href="/login">Log in</a>
        </div>
        <form id="safety-report-form" class="form" hidden>
          <label>Your name (optional)<input id="report-name" autocomplete="name" /></label>
          <label>Are you using Nexus Plus?<select id="nexus-user"><option value="no">No / Not sure</option><option value="yes">Yes</option></select></label>
          <div id="website-contact">
            <label>Contact email<input id="report-email" type="email" autocomplete="email" /></label>
            <label>Contact phone<input id="report-phone" type="tel" autocomplete="tel" /></label>
          </div>
          <label>What do you need help with?
            <select id="report-type">
              <option>Harassment or intimidation</option>
              <option>Online abuse or threats</option>
              <option>Domestic or relationship safety concern</option>
              <option>Public-place safety concern</option>
              <option>Support or guidance</option>
              <option>Something else</option>
            </select>
          </label>
          <label>What happened?<textarea id="report-message" minlength="10" required placeholder="Tell us only what you are comfortable sharing."></textarea></label>
          <label>How would you prefer to be contacted?
            <select id="report-contact-mode"><option value="secure-chat">Private chat</option><option value="voice">Private voice support</option><option value="either">Chat or voice</option></select>
          </label>
          <label class="checkbox-row"><input id="report-consent" type="checkbox" required /> I understand this is a support channel and not a replacement for emergency services.</label>
          <button class="button primary" type="submit">Send private report</button>
          <p id="report-status" class="note" aria-live="polite"></p>
        </form>
      </article>

      <article class="card">
        <p class="eyebrow">What to expect</p>
        <h2>Simple, private support.</h2>
        <div class="grid-3">
          <div class="stat"><strong>1. You ask</strong><span class="muted">Share only the information needed to understand your concern.</span></div>
          <div class="stat"><strong>2. We review</strong><span class="muted">The request is handled privately by the appropriate support process.</span></div>
          <div class="stat"><strong>3. We respond</strong><span class="muted">If follow-up is available, you receive a private way to continue.</span></div>
        </div>
        <p class="note" style="margin-top:16px">A private report does not automatically file a police complaint or guarantee an emergency response.</p>
      </article>
    </div>
  </section>

  <section class="section surface-soft" id="support">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Support</p><h2>Designed around privacy.</h2><p class="muted">Support workers receive only the information needed for the active case. Women’s cases can be routed to approved women support workers, and men’s cases can be routed to approved men support workers.</p></div>
      </div>
      <div class="grid-3">
        <article class="card"><h3>Private conversation</h3><p class="muted">Follow-up can use a private case conversation instead of exposing your phone number or public profile.</p></article>
        <article class="card"><h3>Chat or voice</h3><p class="muted">When available, support can continue through private messaging or a voice session.</p></article>
        <article class="card"><h3>Need a person?</h3><p class="muted">Approved support volunteers go through screening before they can receive safety-support responsibilities.</p><a class="button" href="/join-team">See support roles</a></article>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  const token=localStorage.getItem("nexus-access-token");
  const form=document.getElementById("safety-report-form");
  const loginNote=document.getElementById("login-note");
  const status=document.getElementById("report-status");
  const nexusUser=document.getElementById("nexus-user");
  const contact=document.getElementById("website-contact");
  const syncContact=()=>{const appUser=nexusUser?.value==="yes";if(contact)contact.hidden=appUser;document.getElementById("report-email").required=!appUser;document.getElementById("report-phone").required=!appUser;};
  if(token){form.hidden=false;loginNote.hidden=true;syncContact();}
  nexusUser?.addEventListener("change",syncContact);
  form?.addEventListener("submit",async e=>{
    e.preventDefault();
    status.textContent="Sending your private report…";
    try{
      if(!token) throw new Error("Please log in before sending a private report.");
      if(!supabaseUrl||!supabaseKey) throw new Error("The support service is temporarily unavailable.");
      const r=await fetch(supabaseUrl+"/functions/v1/submit-women-safety-private-report",{method:"POST",headers:{apikey:supabaseKey,Authorization:"Bearer "+token,"Content-Type":"application/json"},body:JSON.stringify({
        contact_name:document.getElementById("report-name").value.trim(),
        contact_email:document.getElementById("report-email").value.trim(),
        contact_phone:document.getElementById("report-phone").value.trim(),
        nexus_plus_user:nexusUser.value==="yes",
        concern_type:document.getElementById("report-type").value,
        message:document.getElementById("report-message").value.trim(),
        contact_mode:document.getElementById("report-contact-mode").value
      })});
      if(!r.ok) throw new Error("We could not send your report right now. Please try again.");
      form.reset();syncContact();status.textContent="Your private report has been sent. Keep your account available for follow-up.";
    }catch(error){status.textContent=error instanceof Error?error.message:"We could not send your report right now.";}
  });
</script>
