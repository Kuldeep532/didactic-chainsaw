---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Join Our Team — Nexus Wave Technologies">
  <section class="hero"><div class="container"><p class="eyebrow">Community</p><h1>Join our team.</h1><p class="lead">Contribute through spiritual content, audio, translation, teaching, accessibility QA, outreach and support.</p></div></section>
  <section class="section"><div class="container grid-3">
    <article class="card"><h3>Bhagavad Gita audio</h3><p class="muted">Contribute accessible spiritual audio.</p></article><article class="card"><h3>Ramayana audio</h3><p class="muted">Help expand accessible audio content.</p></article><article class="card"><h3>Translation</h3><p class="muted">Support Hindi, English and future language content.</p></article><article class="card"><h3>Volunteer / promotion</h3><p class="muted">Help community outreach and product awareness.</p></article><article class="card"><h3>Teacher / Gita educator</h3><p class="muted">Support spiritual learning and educational content.</p></article><article class="card"><h3>Accessibility QA</h3><p class="muted">Test products with assistive technology and real workflows.</p></article>
  </div></section>
  <section class="section surface-soft"><div class="container grid-2"><div class="card"><h2>Application</h2><form id="team-form" class="form"><label>Name<input id="name" required /></label><label>Email<input id="email" type="email" required /></label><label>Area<select id="area" required><option value="">Select an area</option><option>Bhagavad Gita audio</option><option>Ramayana audio</option><option>Translation</option><option>Volunteer / promotion</option><option>Teacher / Gita educator</option><option>Accessibility QA</option></select></label><label>Message<textarea id="message" minlength="10" required></textarea></label><button class="button primary" type="submit">Submit application</button><p id="team-status" class="note" aria-live="polite"></p></form></div><div class="card"><h3>Privacy note</h3><p class="muted">Your application is sent to the configured Supabase backend. Do not include passwords, payment details or other secrets.</p></div></div></section>
  <script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
    const form=document.getElementById("team-form"),status=document.getElementById("team-status");
    form?.addEventListener("submit",async(e)=>{e.preventDefault();if(!supabaseUrl||!supabaseKey){status.textContent="Supabase application storage is not configured.";return;}status.textContent="Submitting…";try{const r=await fetch(supabaseUrl+"/rest/v1/team_applications",{method:"POST",headers:{apikey:supabaseKey,Authorization:"Bearer "+supabaseKey,"Content-Type":"application/json","Prefer":"return=minimal"},body:JSON.stringify({name:document.getElementById("name").value.trim(),email:document.getElementById("email").value.trim(),area:document.getElementById("area").value,message:document.getElementById("message").value.trim()})});if(!r.ok)throw new Error();form.reset();status.textContent="Application submitted successfully.";}catch{status.textContent="We could not submit the application right now. Please try again.";}}); 
  </script>
</Layout>