---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Join the Team — Nexus Wave Technologies" description="Find a simple way to contribute to Nexus Wave Technologies.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Join the team</p>
      <h1>Bring your skills. Make something useful.</h1>
      <p class="lead">Choose one area that feels right for you. You do not need to be a developer to contribute.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Choose how you want to help</p><h2>Simple ways to contribute</h2></div>
      </div>

      <div class="grid-3">
        <article class="card">
          <p class="eyebrow">Audio recording</p>
          <h3>Bhagavad Gita & Ramayan</h3>
          <p class="muted">Help create clear, accessible recordings for spiritual learning.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Languages</p>
          <h3>Translation & teaching</h3>
          <p class="muted">Help make Gita and other learning content easier to understand in more languages.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Accessibility</p>
          <h3>Test with real devices</h3>
          <p class="muted">Help us make screens, controls, audio and navigation easier for everyone.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Women Safety</p>
          <h3>Join Women Safety Campaign</h3>
          <p class="muted">Help with respectful awareness messages, useful resources and responsible community outreach.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Community</p>
          <h3>Community & forum</h3>
          <p class="muted">Help keep conversations useful, welcoming and respectful.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Creative work</p>
          <h3>Writing & awareness</h3>
          <p class="muted">Create poems, educational messages, guides and other helpful content.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section surface-soft" id="safety-campaign">
    <div class="container grid-2">
      <article class="card">
        <p class="eyebrow">Join Women Safety Campaign</p>
        <h2>Help people find better safety information.</h2>
        <p class="muted">Campaign work is about awareness, practical resources and respectful communication. It does not give you access to private safety cases.</p>
        <ul class="feature-list">
          <li>Create clear safety-awareness content.</li>
          <li>Share verified public resources responsibly.</li>
          <li>Help make information easier to access.</li>
        </ul>
      </article>
      <article class="card">
        <p class="eyebrow">Private support roles</p>
        <h2>Support work needs extra screening.</h2>
        <p class="muted">Safety support roles are different from campaign work. Shortlisted support applicants complete a human interview and safeguarding review before receiving any private case access.</p>
        <p class="note">Women’s cases can be supported by approved women volunteers. Men’s cases can be supported by approved men volunteers.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="card">
        <p class="eyebrow">Apply</p>
        <h2>Tell us how you would like to help.</h2>
        <form id="team-form" class="form">
          <label>Your name<input id="name" autocomplete="name" required /></label>
          <label>Email<input id="email" type="email" autocomplete="email" required /></label>
          <label>Choose an area
            <select id="area" required>
              <option value="">Select one</option>
              <option>Bhagavad Gita audio recording</option>
              <option>Ramayan audio recording</option>
              <option>Translation</option>
              <option>Teaching & learning</option>
              <option>Accessibility testing</option>
              <option>Join Women Safety Campaign</option>
              <option>Community & forum</option>
              <option>Writing & awareness</option>
              <option>Private safety support</option>
            </select>
          </label>
          <label>Why would you like to help?<textarea id="message" minlength="10" required placeholder="A few sentences are enough."></textarea></label>
          <label>Would you be available for a short conversation?
            <select id="interview-availability" required><option value="">Select one</option><option>Yes</option><option>No</option></select>
          </label>
          <button class="button primary" type="submit">Send application</button>
          <p id="team-status" class="note" aria-live="polite"></p>
        </form>
      </article>

      <article class="card">
        <p class="eyebrow">What happens next</p>
        <h2>Clear and human.</h2>
        <ol class="feature-list">
          <li>We read your application.</li>
          <li>We contact you if your area is a match.</li>
          <li>Safety-support applicants complete additional screening.</li>
          <li>You receive the next steps directly.</li>
        </ol>
        <p class="note">Please never send passwords, payment details or private information about another person in your application.</p>
      </article>
    </div>
  </section>
</Layout>

<script is:inline>
  const form=document.getElementById("team-form"),status=document.getElementById("team-status");
  form?.addEventListener("submit",async e=>{
    e.preventDefault();status.textContent="Sending your application…";
    try{
      const {requireSupabase}=await import("../lib/supabase");
      const area=document.getElementById("area").value;
      const types={
        "Join Women Safety Campaign":"women_safety_campaign",
        "Community & forum":"community_forum_organizer",
        "Writing & awareness":"safety_content_poetry"
      };
      const {error}=await requireSupabase().from("nexus_team_applications").insert({
        full_name:document.getElementById("name").value.trim(),
        email:document.getElementById("email").value.trim(),
        application_type:types[area]||"volunteer",
        app_scope:"both",
        message:document.getElementById("message").value.trim(),
        consent:true
      });
      if(error)throw error;
      form.reset();status.textContent="Thank you. Your application has been sent for review.";
    }catch(error){status.textContent="We could not send your application right now. Please try again in a moment.";}
  });
</script>
