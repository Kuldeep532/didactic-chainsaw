---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Join Our Team — Nexus Wave Technologies" description="Apply to contribute to Nexus Wave Technologies.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Community</p>
      <h1>Join our team.</h1>
      <p class="lead">Contribute through spiritual content, audio, translation, teaching, accessibility QA, Women Safety campaigns, safety poetry/content, forum moderation and community organization.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-3">
      <article class="card"><h3>Bhagavad Gita audio</h3><p class="muted">Contribute accessible spiritual audio.</p></article>
      <article class="card"><h3>Ramayana audio</h3><p class="muted">Help expand accessible audio content.</p></article>
      <article class="card"><h3>Translation</h3><p class="muted">Support Hindi, English and future language content.</p></article>
      <article class="card"><h3>Volunteer / promotion</h3><p class="muted">Help community outreach and product awareness.</p></article>
      <article class="card"><h3>Teacher / Gita educator</h3><p class="muted">Support spiritual learning and educational content.</p></article>
      <article class="card"><h3>Accessibility QA</h3><p class="muted">Test products with assistive technology and real workflows.</p></article>
      <article class="card"><h3>Women Safety Campaign Volunteer</h3><p class="muted">Support safety awareness, verified resources, responsible outreach and campaign activities.</p></article>
      <article class="card"><h3>Safety Content & Poetry</h3><p class="muted">Create respectful poems, campaign messages and educational content focused on dignity, awareness and safety.</p></article>
      <article class="card"><h3>Forum Moderator</h3><p class="muted">Help review forum discussions and surface policy or safety concerns for the moderation team.</p></article>
      <article class="card"><h3>Community & Forum Organizer</h3><p class="muted">Help organize categories, discussions and community activities without creating categories yourself.</p></article>
    </div>
  </section>
  <section class="section surface-soft" id="support-roles">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Women Safety Support Network</p><h2>Dedicated support roles, separated by case visibility.</h2><p class="muted">Women volunteers support women cases. Men volunteers support men cases. A support worker receives only the cases assigned to their role and never gets broad access to unrelated user profiles.</p></div>
      </div>
      <div class="grid-3">
        <article class="card"><p class="eyebrow">Women</p><h3>Saheli Care Guide</h3><p class="muted">Trained women volunteers for women-focused support cases, listening and safe follow-up.</p></article>
        <article class="card"><p class="eyebrow">Women</p><h3>Shakti Response Companion</h3><p class="muted">Women volunteers who can take active support conversations when a case requires live assistance.</p></article>
        <article class="card"><p class="eyebrow">Men</p><h3>Sahara Support Guide</h3><p class="muted">Male volunteers for men’s support cases, with strict case-based access.</p></article>
        <article class="card"><p class="eyebrow">Men</p><h3>Rakshak Response Companion</h3><p class="muted">Male volunteers available for active men’s support conversations, including future voice sessions.</p></article>
        <article class="card"><p class="eyebrow">Safety</p><h3>Case Privacy Steward</h3><p class="muted">A restricted role focused on case safety and access review, not browsing profiles.</p></article>
        <article class="card"><p class="eyebrow">Accessibility</p><h3>Access Care Specialist</h3><p class="muted">Helps ensure private support works with assistive technology and accessible communication methods.</p></article>
      </div>
    </div>
  </section>
  <section class="section surface-soft">
    <div class="container grid-2">
      <div class="card">
        <h2>Application</h2>
        <form id="team-form" class="form">
          <label>Name<input id="name" required /></label>
          <label>Email<input id="email" type="email" required /></label>
          <label>Area<select id="area" required><option value="">Select an area</option><option>Bhagavad Gita audio</option><option>Ramayana audio</option><option>Translation</option><option>Volunteer / promotion</option><option>Teacher / Gita educator</option><option>Accessibility QA</option><option>Women Safety Campaign Volunteer</option><option>Safety Content & Poetry</option><option>Forum Moderator</option><option>Community & Forum Organizer</option></select></label>
          <p class="note"><strong>Safety-role screening:</strong> Women Safety Support roles are not granted automatically. Shortlisted applicants must complete a human interview and screening focused on motivation, confidentiality, boundaries, respectful communication, escalation and safeguarding. Only applicants who pass that process can receive a support role.</p>
          <label>Why do you want to help?<textarea id="message" minlength="10" required></textarea>
          <label>Are you available for a short interview?<select id="interview-availability" required><option value="">Select</option><option>Yes</option><option>No</option></select></label></label>
          <button class="button primary" type="submit">Submit application</button>
          <p id="team-status" class="note" aria-live="polite"></p>
        </form>
      </div>
      <div class="card">
        <h3>Connected to Nexus</h3>
        <p class="muted">Applications are stored through the same Supabase-backed website infrastructure used by the account and community experience.</p>
        <p class="note">Never include passwords, payment details or API secrets in an application.</p>
        <div class="actions"><a class="button" href="/shlok">Read Bhagavad Gita</a><a class="button" href="/apps">Explore Nexus apps</a></div>
      </div>
    </div>
  </section>
</Layout>
<script>
  const form=document.getElementById("team-form");
  const status=document.getElementById("team-status");
  form?.addEventListener("submit",async(e)=>{
    e.preventDefault();
    status.textContent="Submitting…";
    try {
      const { requireSupabase } = await import("../lib/supabase");
      const { error } = await requireSupabase().from("nexus_team_applications").insert({
        full_name:document.getElementById("name").value.trim(),
        email:document.getElementById("email").value.trim(),
        application_type:({
          "Women Safety Campaign Volunteer":"women_safety_campaign",
          "Safety Content & Poetry":"safety_content_poetry",
          "Forum Moderator":"forum_moderator",
          "Community & Forum Organizer":"community_forum_organizer"
        })[document.getElementById("area").value] || "volunteer",
        app_scope:"both",
        message:document.getElementById("message").value.trim(),
        consent:true
      });
      if (error) throw error;
      form.reset();
      status.textContent="Application submitted successfully.";
    } catch (error) {
      status.textContent=error instanceof Error?error.message:"We could not submit the application right now.";
    }
  });
</script>