---
import Layout from "../layouts/Layout.astro";
import { requireSupabase } from "../lib/supabase";
const supabase = requireSupabase();
void supabase;
---
<Layout title="Community Verification — Nexus Wave Technologies" description="Free manual verification for Nexus Community membership.">
  <section class="hero"><div class="container hero-shell">
    <div><p class="eyebrow">Free membership</p><h1>Apply for Nexus Community access.</h1><p class="lead">A normal Nexus account can read official team posts. Manual verification is required to access user profiles, user posts, friends and private networking.</p></div>
    <div class="hero-panel"><p class="eyebrow">No cost</p><h2>Community membership is free.</h2><p class="muted">Verification is currently manual and reviewed by the Nexus admin team.</p></div>
  </div></section>
  <section class="section"><div class="container grid-2">
    <article class="card"><p class="eyebrow">Apply</p><h2>Verification request</h2>
      <form id="verify-form" class="form">
        <label>Preferred username<input id="username" required maxlength="40" pattern="[A-Za-z0-9_.-]+" /></label>
        <label>Display name<input id="display-name" required maxlength="80" /></label>
        <label>Community category<select id="category" required><option value="">Select</option><option value="female">Female community</option><option value="male">Male community</option></select></label>
        <label>Why do you want community access?<textarea id="reason" required minlength="20" maxlength="1500"></textarea></label>
        <label>Unique verification ID<input id="verification-id" required maxlength="100" placeholder="Your Nexus verification/member ID" /></label>
        <p class="note">Verification is manual. Do not upload identity documents into a public form. The admin team may request a safer verification step separately when necessary.</p>
        <button class="button primary" type="submit">Submit verification request</button>
        <p id="verify-status" class="note" aria-live="polite"></p>
      </form>
    </article>
    <article class="card"><p class="eyebrow">What happens next</p><h2>Simple and transparent.</h2>
      <ol class="feature-list"><li>Your application is stored as a pending verification request.</li><li>An authorized admin manually reviews the request.</li><li>The admin can approve, reject or request clarification.</li><li>Approved members gain access to the member-only Community features.</li></ol>
      <p class="note">Cross-category private chat is not available automatically. Both members must explicitly request/approve the connection, and the server must verify that the approved relationship permits messaging.</p>
    </article>
  </div></section>
</Layout>
<script is:inline>
  const form=document.getElementById("verify-form"), status=document.getElementById("verify-status");
  form?.addEventListener("submit",async e=>{e.preventDefault();status.textContent="Submitting your free verification request…";status.textContent="Verification request prepared. The admin review endpoint must be connected before it can be submitted.";});
</script>