---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Community — Nexus Wave Technologies" description="Nexus community posts, user help and respectful discussion.">
  <section class="hero"><div class="container"><p class="eyebrow">Nexus Community</p><h1>Share, help, ask and learn.</h1><p class="lead">The community has two clear spaces: Posts for published community content, and Users for questions, helpful answers, ideas and personal contributions.</p></div></section>
  <section class="section"><div class="container">
    <div class="community-tabs" role="tablist" aria-label="Community sections">
      <a class="button" href="/chats">My Chats</a>
      <button class="button primary community-tab" id="posts-tab" role="tab" aria-selected="true" aria-controls="posts-panel">Posts</button>
      <button class="button community-tab" id="users-tab" role="tab" aria-selected="false" aria-controls="users-panel">Users</button>
    </div>
    <div id="posts-panel" role="tabpanel" aria-labelledby="posts-tab" class="tab-panel">
      <div id="posts-grid" class="grid-3"><div class="card"><h3>Loading posts…</h3><p class="muted">Connecting to Supabase.</p></div></div>
    </div>
    <div id="users-panel" role="tabpanel" aria-labelledby="users-tab" class="tab-panel" hidden>
      <div class="grid-2">
        <article class="card">
          <p class="eyebrow">Ask & help</p><h2>Share something useful.</h2>
          <p class="muted">Users can ask questions, share practical answers, write ideas or post experiences. Content must remain respectful and must not contain hate, threats or targeted harassment.</p>
          <form id="user-post-form" class="form">
            <label>Title<input id="user-title" required maxlength="120" /></label>
            <label>Type<select id="user-type"><option>Question</option><option>Helpful answer</option><option>Idea</option><option>Experience</option><option>General discussion</option></select></label>
            <label>Your content<textarea id="user-content" minlength="10" maxlength="5000" required></textarea></label>
            <p class="note">Hate speech, threats, targeted harassment, doxxing and deliberately harmful content are not allowed. Submissions may be moderated before publication.</p>
            <button class="button primary" type="submit">Submit for review</button><p id="user-status" class="note" aria-live="polite"></p>
          </form>
        </article>
        <article class="card">
          <p class="eyebrow">Community standards</p><h2>Help without harming.</h2>
          <ul class="feature-list">
            <li>Ask and answer in good faith.</li><li>Do not attack people for identity, beliefs or background.</li><li>Do not post private contact details or sensitive personal information.</li><li>Report content that appears hateful, threatening, fraudulent or abusive.</li>
          </ul>
          <p class="note">The moderation system should block or hold hateful content before it becomes public whenever possible.</p>
        </article>
      </div>
    </div>
    <p id="community-message" class="note" aria-live="polite" style="margin-top:1rem"></p>
  </div></section>
</Layout>
<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  const postsGrid=document.getElementById("posts-grid"), message=document.getElementById("community-message");
  const form=document.getElementById("user-post-form"), userStatus=document.getElementById("user-status");
  const postsTab=document.getElementById("posts-tab"), usersTab=document.getElementById("users-tab"), postsPanel=document.getElementById("posts-panel"), usersPanel=document.getElementById("users-panel");
  const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
  const speak=t=>{"speechSynthesis" in window&& (speechSynthesis.cancel(),speechSynthesis.speak(new SpeechSynthesisUtterance(t)))};
  function selectTab(which){const users=which==="users";postsTab.setAttribute("aria-selected",String(!users));usersTab.setAttribute("aria-selected",String(users));postsTab.classList.toggle("primary",!users);usersTab.classList.toggle("primary",users);postsPanel.hidden=users;usersPanel.hidden=!users}
  postsTab.onclick=()=>selectTab("posts");usersTab.onclick=()=>selectTab("users");
  async function loadPosts(){
    if(!supabaseUrl||!supabaseKey){postsGrid.innerHTML='<div class="card"><h3>Community is not configured</h3><p class="muted">Supabase public configuration is missing.</p></div>';return}
    try{const headers={apikey:supabaseKey,Authorization:"Bearer "+supabaseKey};const r=await fetch(supabaseUrl+"/rest/v1/posts?select=*&status=eq.approved&order=created_at.desc",{headers});const data=await r.json().catch(()=>[]);if(!r.ok||!Array.isArray(data))throw 0;if(!data.length){postsGrid.innerHTML='<div class="card"><h3>No published posts yet.</h3><p class="muted">Approved posts will appear here.</p></div>';return}postsGrid.innerHTML=data.map((p,i)=>'<article class="card"><p class="eyebrow">Post</p><h3>'+esc(p.title||"Community post")+'</h3><p class="muted">'+esc(p.content||p.body||"")+'</p><div class="actions"><button class="button primary" type="button" data-listen="'+i+'">Listen</button></div></article>').join("");data.forEach((p,i)=>document.querySelector('[data-listen="'+i+'"]')?.addEventListener("click",()=>speak((p.title||"Community post")+". "+(p.content||p.body||""))))}catch{postsGrid.innerHTML='<div class="card"><h3>Could not load posts.</h3><p class="muted">Please try again later.</p></div>'}
  }
  function containsBlockedLanguage(text){const t=text.toLowerCase();const blocked=["kill yourself","go die","hate all","death to","i will hurt"];return blocked.some(x=>t.includes(x))}
  form?.addEventListener("submit",async e=>{e.preventDefault();const title=document.getElementById("user-title").value.trim(),type=document.getElementById("user-type").value,content=document.getElementById("user-content").value.trim();if(containsBlockedLanguage(title+" "+content)){userStatus.textContent="This content appears to contain threatening or hateful language and cannot be submitted.";return}userStatus.textContent="Submitting for review…";try{const r=await fetch(supabaseUrl+"/rest/v1/posts",{method:"POST",headers:{apikey:supabaseKey,Authorization:"Bearer "+supabaseKey,"Content-Type":"application/json","Prefer":"return=minimal"},body:JSON.stringify({title,type,content,status:"pending"})});if(!r.ok)throw 0;userStatus.textContent="Submitted for moderation. It will appear publicly only after approval.";form.reset()}catch{userStatus.textContent="The user-post endpoint is not connected yet. The community submission flow is ready for Supabase."}});
  void loadPosts();
</script>