---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Forum — Nexus Wave Technologies" description="Category-based Nexus forum for approved community discussions.">
  <section class="section community-shell">
    <div class="container">
      <div class="community-appbar">
        <div>
          <p class="eyebrow">Nexus Community</p>
          <h1 class="community-title">Forum</h1>
          <p class="muted">One feed for Nexus updates and approved member posts.</p>
        </div>
        <div class="community-actions">
          <a class="button" href="/chats">My Chats</a>
          <a class="button" href="/friends">My Friends</a>
          <button id="add-post-button" class="button primary" type="button" disabled title="Verification is required">Add New Post</button>
        </div>
      </div>

      <div id="verification-banner" class="verification-banner" role="status">
        <div>
          <strong>Verify to access posting and networking</strong>
          <span class="muted">Free manual verification unlocks member features.</span>
        </div>
        <a class="button" href="/verify-community">Verify now</a>
      </div>

      <nav class="community-tabbar" aria-label="Community sections">
        <a class="community-tab active" href="/community">Posts</a>
        <a class="community-tab" href="/chats">My Chats</a>
        <a class="community-tab" href="/friends">My Friends</a>
      </nav>

      <section class="community-panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Posts</p>
            <h2>Community feed</h2>
          </div>
          <span class="muted">Official and approved member posts</span>
        </div>
        <div id="posts-grid" class="grid-3">
          <div class="card"><h3>Loading posts…</h3><p class="muted">Connecting to Supabase.</p></div>
        </div>
      </section>

      <section id="my-post-panel" class="community-panel" hidden>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">My Post</p>
            <h2>Create a post</h2>
          </div>
        </div>
        <form id="user-post-form" class="form">
          <label>Post title<input id="user-title" required maxlength="120" /></label>
          <label>Category<select id="post-category" required></select></label>
          <label>Audience<select id="post-audience" required><option value="all">Everyone</option><option value="female">Women</option><option value="male">Men</option></select></label>
          <label>Post<textarea id="user-content" minlength="10" maxlength="5000" required placeholder="Write your post…"></textarea></label>
          <p class="note">Member posts go through moderation before they appear in the public feed.</p>
          <div class="actions">
            <button class="button primary" type="submit">Publish My Post</button>
            <button id="close-post" class="button" type="button">Cancel</button>
          </div>
          <p id="user-status" class="note" aria-live="polite"></p>
        </form>
      </section>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  const addPostButton=document.getElementById("add-post-button");
  const postPanel=document.getElementById("my-post-panel");
  const closePost=document.getElementById("close-post");
  const form=document.getElementById("user-post-form");
  const userStatus=document.getElementById("user-status");
  const grid=document.getElementById("posts-grid");
  const banner=document.getElementById("verification-banner");
  const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
  const speak=t=>{"speechSynthesis" in window&&(speechSynthesis.cancel(),speechSynthesis.speak(new SpeechSynthesisUtterance(t)))};

  const apiHeaders=()=>({apikey:supabaseKey,Authorization:"Bearer "+supabaseKey});
  const jsonHeaders=()=>({...apiHeaders(),"Content-Type":"application/json"});

  function enableVerifiedUi(verified){
    addPostButton.disabled=!verified;
    addPostButton.title=verified ? "Create a new post" : "Verification is required";
    banner.hidden=verified;
  }

  async function getCurrentUser(){
    if(!supabaseUrl||!supabaseKey) return null;
    try{
      const auth=await fetch(supabaseUrl+"/auth/v1/user",{headers:apiHeaders()});
      if(!auth.ok) return null;
      return await auth.json();
    }catch{return null;}
  }

  async function checkMembership(){
    try{
      const user=await getCurrentUser();
      if(!user?.id){ enableVerifiedUi(false); return; }
      const r=await fetch(supabaseUrl+"/rest/v1/profiles?select=verification_status&id=eq."+encodeURIComponent(user.id)+"&limit=1",{headers:apiHeaders()});
      if(!r.ok) return;
      const rows=await r.json();
      enableVerifiedUi(rows[0]?.verification_status==="verified");
    }catch{}
  }

  let selectedCategory="";
  const categoryList=document.getElementById("category-list");
  const selectedTitle=document.getElementById("selected-category-title");
  const audienceFilter=document.getElementById("audience-filter");

  async function loadForumCategories(){
    try{
      const r=await fetch(supabaseUrl+"/rest/v1/forum_categories?select=id,name,description&active=eq.true&order=name",{headers:apiHeaders()});
      const data=await r.json().catch(()=>[]);
      if(!r.ok||!Array.isArray(data)) throw 0;
      categoryList.innerHTML=data.map(c=>'<button class="forum-category-card" type="button" data-category="'+esc(c.id)+'"><strong>'+esc(c.name)+'</strong><span>'+esc(c.description||"")+'</span></button>').join("");
      data.forEach(c=>document.querySelector('[data-category="'+c.id+'"]')?.addEventListener("click",()=>selectForumCategory(c)));
      if(data[0]) await selectForumCategory(data[0]);
    }catch{
      categoryList.innerHTML='<div class="card"><h3>Forum categories are temporarily unavailable.</h3><p class="muted">Please try again later.</p></div>';
    }
  }

  async function selectForumCategory(category){
    selectedCategory=category.id;
    selectedTitle.textContent=category.name;
    document.querySelectorAll(".forum-category-card").forEach(el=>el.classList.toggle("selected",el.dataset.category===selectedCategory));
    await loadForumPosts();
  }

  async function loadForumPosts(){
    if(!selectedCategory) return;
    try{
      let url=supabaseUrl+"/rest/v1/forum_posts?select=id,title,content,created_at,post_source,audience&status=eq.approved&category_id=eq."+encodeURIComponent(selectedCategory)+"&order=created_at.desc";
      const audience=audienceFilter?.value||"all";
      if(audience!=="all") url+="&audience=in.(all,"+audience+")";
      const r=await fetch(url,{headers:apiHeaders()});
      const data=await r.json().catch(()=>[]);
      if(!r.ok||!Array.isArray(data)) throw 0;
      grid.innerHTML=data.length?data.map((p,i)=>{
        const source=p.post_source==="official"?"Official":"Member";
        const who=p.audience==="female"?"Women":p.audience==="male"?"Men":"Everyone";
        return '<article class="card"><p class="eyebrow">'+esc(source)+' · '+esc(who)+'</p><h3>'+esc(p.title||"Forum discussion")+'</h3><p class="muted">'+esc(p.content||"")+'</p><button class="button" type="button" data-forum-listen="'+i+'">Listen</button></article>';
      }).join(""):'<div class="card"><h3>No approved discussions yet.</h3><p class="muted">Approved posts in this category will appear here.</p></div>';
      data.forEach((p,i)=>document.querySelector('[data-forum-listen="'+i+'"]')?.addEventListener("click",()=>speak((p.title||"Forum discussion")+". "+(p.content||""))));
    }catch{
      grid.innerHTML='<div class="card"><h3>Forum discussions are temporarily unavailable.</h3><p class="muted">Please try again later.</p></div>';
    }
  }

  audienceFilter?.addEventListener("change",()=>void loadForumPosts());
    addPostButton.addEventListener("click",()=>{
    if(addPostButton.disabled) return;
    postPanel.hidden=false;
    document.getElementById("user-title")?.focus();
    postPanel.scrollIntoView({behavior:"smooth",block:"start"});
  });
  closePost?.addEventListener("click",()=>postPanel.hidden=true);

  form?.addEventListener("submit",async e=>{
    e.preventDefault();
    userStatus.textContent="Submitting your post for review…";
    try{
      const user=await getCurrentUser();
      if(!user?.id) throw 0;
      const r=await fetch(supabaseUrl+"/rest/v1/forum_posts",{
        method:"POST",
        headers:{...jsonHeaders(),"Prefer":"return=minimal"},
        body:JSON.stringify({
          category_id:document.getElementById("post-category").value,
          author_id:user.id,
          title:document.getElementById("user-title").value.trim(),
          content:document.getElementById("user-content").value.trim(),
          audience:document.getElementById("post-audience").value,
          status:"pending",
          post_source:"member"
        })
      });
      if(!r.ok) throw 0;
      userStatus.textContent="My Post submitted for moderation.";
      form.reset();
    }catch{
      userStatus.textContent="Your post could not be submitted. Please sign in and try again.";
    }
  });


  async function loadPostCategoriesForComposer(){
    try{
      const r=await fetch(supabaseUrl+"/rest/v1/forum_categories?select=id,name&active=eq.true&order=name",{headers:apiHeaders()});
      const data=await r.json().catch(()=>[]);
      if(!r.ok||!Array.isArray(data)) return;
      const select=document.getElementById("post-category");
      select.innerHTML=data.map(c=>'<option value="'+esc(c.id)+'">'+esc(c.name)+'</option>').join("");
    }catch{}
  }
  void loadPostCategoriesForComposer();

  void checkMembership();
  void loadPosts();
</script>