---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Community — Nexus Wave Technologies" description="Verified Nexus community with official posts and member-only user networking.">
  <section class="hero"><div class="container">
    <p class="eyebrow">Nexus Community</p>
    <h1>Read official updates. Join verified community.</h1>
    <p class="lead">Official team posts remain visible publicly. User profiles, user posts and networking features require a free community membership and manual verification.</p>
  </div></section>

  <section class="section"><div class="container">
    <div class="community-tabs" role="tablist" aria-label="Community sections">
      <a class="button" href="/chats">My Chats</a>
      <a class="button" href="/friends">My Friends</a>
      <a class="button" href="/verify-community">Verify to access this feature</a>
      <a class="button" href="/blog">Official Blog</a>
    </div>

    <article class="card" style="margin-bottom:1rem">
      <p class="eyebrow">Official team posts</p>
      <h2>Updates from Nexus Wave Technologies</h2>
      <p class="muted">Only authorized team members can publish here. Public readers see the author’s official team name; ordinary community profiles are not exposed in this section.</p>
    </article>
    <div id="posts-grid" class="grid-3"><div class="card"><h3>Loading official posts…</h3><p class="muted">Connecting to Supabase.</p></div></div>

    <article id="locked-community" class="card surface-soft" style="margin-top:1rem">
      <p class="eyebrow">Verified community</p>
      <h2>Verify to access this feature</h2>
      <p class="muted">Free community membership is open to eligible account holders. Manual verification is required before user profiles, user posts, friend requests and private networking become visible.</p>
      <a class="button primary" href="/verify-community">Apply for free verification</a>
    </article>
  </div></section>
</Layout>
<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  const grid=document.getElementById("posts-grid");
  const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
  async function loadPosts(){
    if(!supabaseUrl||!supabaseKey){grid.innerHTML='<div class="card"><h3>Community is not configured</h3><p class="muted">Supabase public configuration is missing.</p></div>';return}
    try{
      const headers={apikey:supabaseKey,Authorization:"Bearer "+supabaseKey};
      const r=await fetch(supabaseUrl+"/rest/v1/team_posts?select=title,content,published_at,author_display_name&status=eq.published&order=published_at.desc",{headers});
      const data=await r.json().catch(()=>[]);
      if(!r.ok||!Array.isArray(data)) throw 0;
      if(!data.length){grid.innerHTML='<div class="card"><h3>No official posts yet.</h3><p class="muted">Authorized team posts will appear here.</p></div>';return}
      grid.innerHTML=data.map(p=>'<article class="card"><p class="eyebrow">Official team post</p><h3>'+esc(p.title||"Nexus update")+'</h3><p class="muted">'+esc(p.content||"")+'</p><p class="gita-ref">'+esc(p.author_display_name||"Nexus Team")+'</p></article>').join("");
    }catch{
      grid.innerHTML='<div class="card"><h3>Official posts are temporarily unavailable.</h3><p class="muted">Please try again later.</p></div>';
    }
  }
  void loadPosts();
</script>