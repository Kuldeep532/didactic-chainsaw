---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Community — Nexus Wave Technologies" description="Verified Nexus community with official posts and member-only user networking.">
  <section class="section community-shell">
    <div class="container">
      <div class="community-header">
        <div>
          <p class="eyebrow">Nexus Community</p>
          <h1 class="community-title">Community</h1>
          <p class="muted">Official team posts are public. Member networking is available after free manual verification.</p>
        </div>
        <div class="community-actions">
          <a class="button" href="/chats">My Chats</a>
          <a class="button" href="/friends">My Friends</a>
          <button id="add-post-button" class="button primary" type="button" disabled title="Verification is required">Add New Post</button>
        </div>
      </div>

      <div id="verification-banner" class="verification-banner" role="status">
        <div>
          <strong>Verify to access this feature</strong>
          <span class="muted">Verify your free community membership to create posts and access member networking.</span>
        </div>
        <a class="button" href="/verify-community">Verify now</a>
      </div>

      <nav class="community-tabbar" aria-label="Community sections">
        <a class="community-tab active" href="/community">Posts</a>
        <a class="community-tab" href="/blog">Official Blog</a>
        <a class="community-tab" href="/chats">My Chats</a>
        <a class="community-tab" href="/friends">My Friends</a>
      </nav>

      <section class="community-panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Post</p>
            <h2>Community posts</h2>
          </div>
          <span class="muted">Official posts and approved member posts</span>
        </div>
        <div id="posts-grid" class="grid-3">
          <div class="card"><h3>Loading posts…</h3><p class="muted">Connecting to Supabase.</p></div>
        </div>
      </section>

      <section id="my-post-panel" class="community-panel" hidden>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">My Post</p>
            <h2>Create a post</h2>
          </div>
        </div>
        <form id="user-post-form" class="form">
          <label>Post title<input id="user-title" required maxlength="120" /></label>
          <label>Post<textarea id="user-content" minlength="10" maxlength="5000" required placeholder="Write your post…"></textarea></label>
          <p class="note">Posts are sent for moderation. Hate, threats, targeted harassment, doxxing and deliberately harmful content are not allowed.</p>
          <div class="actions">
            <button class="button primary" type="submit">Publish My Post</button>
            <button id="close-post" class="button" type="button">Cancel</button>
          </div>
          <p id="user-status" class="note" aria-live="polite"></p>
        </form>
      </section>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  const addPostButton=document.getElementById("add-post-button");
  const postPanel=document.getElementById("my-post-panel");
  const closePost=document.getElementById("close-post");
  const form=document.getElementById("user-post-form");
  const userStatus=document.getElementById("user-status");
  const grid=document.getElementById("posts-grid");
  const banner=document.getElementById("verification-banner");
  const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
  const speak=t=>{"speechSynthesis" in window&&(speechSynthesis.cancel(),speechSynthesis.speak(new SpeechSynthesisUtterance(t)))};

  function enableVerifiedUi(verified){
    addPostButton.disabled=!verified;
    addPostButton.title=verified ? "Create a new post" : "Verification is required";
    if(verified) banner.hidden=true;
  }

  async function checkMembership(){
    if(!supabaseUrl||!supabaseKey) return;
    try{
      const headers={apikey:supabaseKey,Authorization:"Bearer "+supabaseKey};
      const r=await fetch(supabaseUrl+"/rest/v1/profiles?select=verification_status&limit=1",{headers});
      if(!r.ok) return;
      const rows=await r.json();
      enableVerifiedUi(rows[0]?.verification_status==="verified");
    }catch{}
  }

  async function loadPosts(){
    if(!supabaseUrl||!supabaseKey){
      grid.innerHTML='<div class="card"><h3>Community is not configured</h3><p class="muted">Supabase public configuration is missing.</p></div>';return;
    }
    try{
      const headers={apikey:supabaseKey,Authorization:"Bearer "+supabaseKey};
      const official=await fetch(supabaseUrl+"/rest/v1/team_posts?select=title,content,published_at,author_display_name&status=eq.published&order=published_at.desc",{headers});
      const data=await official.json().catch(()=>[]);
      if(!official.ok||!Array.isArray(data)) throw 0;
      grid.innerHTML=data.length?data.map((p,i)=>'<article class="card"><p class="eyebrow">Official team post</p><h3>'+esc(p.title||"Nexus update")+'</h3><p class="muted">'+esc(p.content||"")+'</p><p class="gita-ref">'+esc(p.author_display_name||"Nexus Team")+'</p><button class="button" type="button" data-listen="'+i+'">Listen</button></article>').join(""):'<div class="card"><h3>No official posts yet.</h3><p class="muted">Authorized team posts will appear here.</p></div>';
      data.forEach((p,i)=>document.querySelector('[data-listen="'+i+'"]')?.addEventListener("click",()=>speak((p.title||"Nexus update")+". "+(p.content||""))));
    }catch{
      grid.innerHTML='<div class="card"><h3>Official posts are temporarily unavailable.</h3><p class="muted">Please try again later.</p></div>';
    }
  }

  addPostButton.addEventListener("click",()=>{
    if(addPostButton.disabled) return;
    postPanel.hidden=false;
    document.getElementById("user-title")?.focus();
    postPanel.scrollIntoView({behavior:"smooth",block:"start"});
  });
  closePost?.addEventListener("click",()=>postPanel.hidden=true);

  form?.addEventListener("submit",async e=>{
    e.preventDefault();
    userStatus.textContent="Submitting your post for review…";
    try{
      const r=await fetch(supabaseUrl+"/rest/v1/posts",{
        method:"POST",
        headers:{apikey:supabaseKey,Authorization:"Bearer "+supabaseKey,"Content-Type":"application/json","Prefer":"return=minimal"},
        body:JSON.stringify({title:document.getElementById("user-title").value.trim(),content:document.getElementById("user-content").value.trim(),status:"pending"})
      });
      if(!r.ok) throw 0;
      userStatus.textContent="My Post submitted for moderation.";
      form.reset();
    }catch{
      userStatus.textContent="The post submission backend is not connected yet.";
    }
  });

  void checkMembership();
  void loadPosts();
</script>