---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Text Formatter — Nexus Wave Technologies" description="Format and clean text locally in your browser.">
  <section class="hero tool-hero"><div class="container"><p class="eyebrow">Tools</p><h1>Text Formatter</h1><p class="lead">Clean up and transform text without sending it to a server.</p></div></section>
  <section class="section"><div class="container"><a class="button ghost back-link" href="/tools">Back to Tools</a><article class="card"><label for="source">Text</label><textarea id="source" class="tool-control" rows="10" placeholder="Paste or type your text…"></textarea><div class="actions"><button class="button" data-mode="upper">UPPERCASE</button><button class="button" data-mode="lower">lowercase</button><button class="button" data-mode="title">Title Case</button><button class="button" data-mode="sentence">Sentence case</button><button class="button" data-mode="clean">Clean spaces</button></div><label for="output">Result</label><textarea id="output" class="tool-control" rows="10" readonly></textarea><button id="copy" class="button primary" type="button">Copy result</button><p id="status" class="note" aria-live="polite"></p></article></div></section>
  <style>.tool-hero{padding-bottom:32px}.back-link{margin-bottom:18px}.tool-control{width:100%;border:1px solid var(--color-border);border-radius:12px;padding:12px;background:var(--color-surface);color:var(--color-text);font:inherit;resize:vertical}.actions{margin:18px 0;display:flex;flex-wrap:wrap;gap:8px}</style>
  <script>const s=document.getElementById("source"),o=document.getElementById("output"),st=document.getElementById("status");const transform=m=>{const v=s.value;switch(m){case"upper":return v.toUpperCase();case"lower":return v.toLowerCase();case"title":return v.toLowerCase().replace(/\b\w/g,ch=>ch.toUpperCase());case"sentence":return v.trim()?v.trim().charAt(0).toUpperCase()+v.trim().slice(1).toLowerCase():"";case"clean":return v.replace(/[ \t]+/g," ").replace(/\n{3,}/g,"\n\n");default:return v}};document.querySelectorAll("[data-mode]").forEach(b=>b.addEventListener("click",()=>{o.value=transform(b.dataset.mode)}));document.getElementById("copy").addEventListener("click",async()=>{if(!o.value){st.textContent="There is no result to copy yet.";return}try{await navigator.clipboard.writeText(o.value);st.textContent="Result copied."}catch{st.textContent="Copy is not available right now. You can select and copy the result manually."}});</script>
</Layout>