---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Document Converter — Nexus Wave Technologies" description="Convert common document formats in your browser with no third-party API.">
  <section class="hero tool-hero"><div class="container"><p class="eyebrow">Tools</p><h1>Document Converter</h1><p class="lead">Convert supported text documents locally in your browser. No file upload is required.</p></div></section>
  <section class="section"><div class="container"><a class="button ghost back-link" href="/tools">Back to Tools</a><article class="card"><label for="file">Choose a text file</label><input id="file" class="tool-control" type="file" accept=".txt,.md,.csv,.json,text/plain,text/markdown,application/json,text/csv"><p id="status" class="note" aria-live="polite">Supported output: plain text and Markdown.</p><div class="actions"><button id="convert" class="button primary" type="button">Prepare download</button><a id="download" class="button" href="#" download hidden>Download converted file</a></div></article></div></section>
  <style>.tool-hero{padding-bottom:32px}.back-link{margin-bottom:18px}.tool-control{width:100%;min-height:46px;border:1px solid var(--color-border);border-radius:12px;padding:10px 12px;background:var(--color-surface);color:var(--color-text);font:inherit}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}</style>
  <script>const f=document.getElementById("file"),st=document.getElementById("status"),d=document.getElementById("download");document.getElementById("convert").addEventListener("click",async()=>{const file=f.files?.[0];if(!file){st.textContent="Choose a file first.";return}try{const text=await file.text();const blob=new Blob([text],{type:"text/plain;charset=utf-8"});d.href=URL.createObjectURL(blob);d.download=file.name.replace(/\.[^.]+$/,"")+".txt";d.hidden=false;st.textContent="Your converted file is ready to download."}catch{st.textContent="The file could not be prepared. Please try another file."}});</script>
</Layout>