---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="URL Encoder & Decoder — Nexus Wave Technologies" description="Encode or decode URL text locally in your browser.">
  <section class="hero tool-hero"><div class="container"><p class="eyebrow">Tools</p><h1>URL Encoder & Decoder</h1><p class="lead">Prepare URL text safely without sending it to a server.</p></div></section>
  <section class="section"><div class="container"><a class="button ghost back-link" href="/tools">Back to Tools</a><article class="card">
    <label for="url-input">Text or URL</label><textarea id="url-input" class="tool-control" rows="10" placeholder="Paste text or a URL…"></textarea>
    <div class="actions"><button id="encode" class="button primary" type="button">Encode</button><button id="decode" class="button" type="button">Decode</button><button id="copy" class="button" type="button">Copy result</button></div>
    <p id="status" class="note" aria-live="polite"></p>
  </article></div></section>
  <style>.tool-hero{padding-bottom:32px}.back-link{margin-bottom:18px}.tool-control{width:100%;border:1px solid var(--color-border);border-radius:12px;padding:12px;background:var(--color-surface);color:var(--color-text);font:inherit;resize:vertical}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}</style>
  <script>
    const input=document.getElementById("url-input"),status=document.getElementById("status");
    const run=(mode)=>{try{input.value=mode==="encode"?encodeURIComponent(input.value):decodeURIComponent(input.value);status.textContent=mode==="encode"?"Text encoded successfully.":"Text decoded successfully."}catch{status.textContent="The text could not be decoded. Please check it and try again."}};
    document.getElementById("encode").addEventListener("click",()=>run("encode"));document.getElementById("decode").addEventListener("click",()=>run("decode"));
    document.getElementById("copy").addEventListener("click",async()=>{if(!input.value){status.textContent="There is nothing to copy yet.";return}try{await navigator.clipboard.writeText(input.value);status.textContent="Result copied."}catch{status.textContent="Copy is not available. You can select the text and copy it manually."}});
  </script>
</Layout>