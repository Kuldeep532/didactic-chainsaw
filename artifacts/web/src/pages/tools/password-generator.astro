---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Password Generator — Nexus Wave Technologies" description="Generate strong random passwords locally in your browser.">
  <section class="hero tool-hero"><div class="container"><p class="eyebrow">Tools</p><h1>Password Generator</h1><p class="lead">Create a strong random password locally on your device. Nothing is sent to a server.</p></div></section>
  <section class="section"><div class="container"><a class="button ghost back-link" href="/tools">Back to Tools</a><article class="card generator"><label for="password-length">Password length</label><input id="password-length" class="tool-control" type="number" min="8" max="64" value="20"><div class="options"><label><input id="upper" type="checkbox" checked> Uppercase letters</label><label><input id="lower" type="checkbox" checked> Lowercase letters</label><label><input id="numbers" type="checkbox" checked> Numbers</label><label><input id="symbols" type="checkbox" checked> Symbols</label></div><div class="password-row"><input id="password" class="tool-control" type="text" readonly aria-label="Generated password"><button id="generate" class="button primary" type="button">Generate</button><button id="copy" class="button" type="button">Copy</button></div><p id="status" class="note" aria-live="polite"></p></article></div></section>
  <style>.tool-hero{padding-bottom:32px}.back-link{margin-bottom:18px}.generator{display:grid;gap:16px}.options{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.password-row{display:grid;grid-template-columns:1fr auto auto;gap:8px}.tool-control{width:100%;min-height:46px;border:1px solid var(--color-border);border-radius:12px;padding:10px 12px;background:var(--color-surface);color:var(--color-text);font:inherit}@media(max-width:600px){.password-row{grid-template-columns:1fr}.options{grid-template-columns:1fr}}</style>
  <script>const len=document.getElementById("password-length"),out=document.getElementById("password"),st=document.getElementById("status");const sets={upper:"ABCDEFGHJKLMNPQRSTUVWXYZ",lower:"abcdefghijkmnopqrstuvwxyz",numbers:"23456789",symbols:"!@#$%^&*()-_=+[]{}?"};const make=()=>{const enabled=["upper","lower","numbers","symbols"].filter(k=>document.getElementById(k).checked);if(!enabled.length){st.textContent="Select at least one character type.";return}const chars=enabled.map(k=>sets[k]).join("");const result=[];const cryptoObj=globalThis.crypto;for(let i=0;i<Number(len.value);i++)result.push(chars[Math.floor((cryptoObj?.getRandomValues?.(new Uint32Array(1))[0]??Math.random()*2**32)/2**32*chars.length)]);out.value=result.join("");st.textContent="A new password is ready."};document.getElementById("generate").addEventListener("click",make);document.getElementById("copy").addEventListener("click",async()=>{if(!out.value){make();return}try{await navigator.clipboard.writeText(out.value);st.textContent="Password copied to your clipboard."}catch{st.textContent="Could not copy automatically. Please copy it manually."}});make();</script>
</Layout>