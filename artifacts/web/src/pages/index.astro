---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Nexus Wave Technologies" description="Accessible digital products including Nexus Plus and Geeta Nexus.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Nexus Wave Technologies</p>
      <h1>User-friendly software.<br />Built for real life.</h1>
      <p class="lead">Accessible digital products for everyday productivity, AI, media and spiritual learning.</p>
      <div class="actions">
        <a class="button primary" href="/apps">Explore Nexus apps →</a>
        <a class="button" href="/utilities">Open free utilities</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div><p class="eyebrow">What we build</p><h2>Useful first, simple to understand.</h2><p class="muted">Nexus Wave Technologies is the developer identity used for software products and online services created by Kuldeep.</p></div>
        <div class="grid-2">
          <article class="card"><h3>Privacy-aware</h3><p class="muted">Account and payment information is handled only where needed to provide the service.</p></article>
          <article class="card"><h3>Modern AI tools</h3><p class="muted">Nexus Plus brings AI chat, media, audio and content tools together.</p></article>
          <article class="card"><h3>Spiritual learning</h3><p class="muted">Geeta Nexus provides an accessible way to explore the Bhagavad Gita.</p></article>
          <article class="card"><h3>Small free helpers</h3><p class="muted">Lightweight website utilities without requiring an account.</p></article>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Featured products</p><h2>Nexus Plus &amp; Geeta Nexus</h2>
      <div class="grid-2">
        <article class="card"><h3>Nexus Plus</h3><p class="muted">An Android utility and AI platform with assistant features, media tools, audio editing, PDF tools, e-paper workflows and accessibility-focused features.</p><div class="actions"><a class="button primary" href="/apps#nexus-plus">See Nexus Plus</a></div></article>
        <article class="card"><h3>Geeta Nexus</h3><p class="muted">A dedicated Bhagavad Gita experience focused on clear reading, accessibility and spiritual learning.</p><div class="actions"><a class="button" href="/apps#geeta-nexus">See Geeta Nexus</a></div></article>
      </div>
    </div>
  </section>
</Layout>