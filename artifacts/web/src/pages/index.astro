---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Nexus Wave Technologies" description="Accessible software, AI, utilities and spiritual learning from Nexus Wave Technologies.">
  <section class="hero">
    <div class="container hero-shell">
      <div>
        <p class="eyebrow">Nexus Wave Technologies</p>
        <h1>User-friendly software. Built for real life.</h1>
        <p class="lead">Accessible digital products for productivity, AI, media, community and spiritual learning.</p>
        <div class="actions">
          <a class="button primary" href="/apps">Explore Nexus Apps</a>
          <a class="button" href="/utilities">Open Free Utilities</a>
        </div>
        <div class="grid-3" style="margin-top:1.5rem">
          <div class="stat"><strong>Accessible</strong><span class="muted">Screen-reader and keyboard-friendly UI</span></div>
          <div class="stat"><strong>Practical</strong><span class="muted">Useful tools without unnecessary complexity</span></div>
          <div class="stat"><strong>Connected</strong><span class="muted">Supabase-backed website services</span></div>
        </div>
      </div>
      <div class="hero-panel">
        <img src="/assets/hero-workspace.jpg" alt="Nexus workspace preview" />
        <p class="muted" style="margin:.8rem 0 0">A cleaner, responsive website foundation ready for the Nexus ecosystem.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Products</p><h2>Nexus Plus and Geeta Nexus</h2></div><a class="button ghost" href="/apps">View all apps</a></div>
      <div class="grid-2">
        <article class="card"><img src="/assets/nexus-plus-mockup.jpg" alt="Nexus Plus app preview" style="width:100%;border-radius:14px;margin-bottom:1rem" /><h3>Nexus Plus</h3><p class="muted">AI assistant, audio and media tools, PDF utilities, e-paper workflows and accessibility-focused features.</p><a class="button primary" href="/apps#nexus-plus">Explore Nexus Plus</a></article>
        <article class="card"><img src="/assets/geeta-nexus-mockup.jpg" alt="Geeta Nexus app preview" style="width:100%;border-radius:14px;margin-bottom:1rem" /><h3>Geeta Nexus</h3><p class="muted">Accessible Bhagavad Gita reading and spiritual learning with a clear, user-friendly experience.</p><a class="button" href="/apps#geeta-nexus">Explore Geeta Nexus</a></article>
      </div>
    </div>
  </section>
  <section class="section daily-section" aria-labelledby="daily-shlok-title">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Geeta Nexus</p><h2 id="daily-shlok-title">आज का श्लोक</h2></div>
        <a class="button primary" href="/shlok">सभी श्लोक पढ़ें</a>
      </div>
      <article class="card daily-shlok-card">
        <p id="daily-shlok-ref" class="gita-ref">श्लोक लोड हो रहा है…</p>
        <h3 id="daily-shlok-text" class="gita-sanskrit" lang="sa">कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।</h3>
        <p id="daily-shlok-meaning" class="gita-meaning" lang="hi">कर्म करने में ही तुम्हारा अधिकार है, उसके फल पर नहीं।</p>
        <div class="actions">
          <button id="daily-shlok-listen" class="button primary" type="button">श्लोक सुनें</button>
          <button id="daily-shlok-copy" class="button" type="button">कॉपी करें</button>
          <a class="button ghost" href="/shlok">Read All Shlokas</a>
        </div>
        <p id="daily-shlok-status" class="note" aria-live="polite">हर दिन श्लोक का चयन अपने आप बदलेगा।</p>
      </article>
    </div>
  </section>
  <section class="section surface-soft">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Website services</p><h2>Everything in one simple place.</h2></div></div>
      <div class="grid-4">
        <article class="card"><h3>Utilities</h3><p class="muted">Fast browser-based text helpers.</p><a href="/utilities">Open utilities →</a></article>
        <article class="card"><h3>Community</h3><p class="muted">Community posts with accessible listening.</p><a href="/community">Open community →</a></article>
        <article class="card"><h3>Accounts</h3><p class="muted">Supabase-powered sign-in and account access.</p><a href="/login">Sign in →</a></article>
        <article class="card"><h3>Team</h3><p class="muted">Contribute through accessibility, audio, teaching and support.</p><a href="/join-team">Join the team →</a></article>
      </div>
    </div>
  </section>
  <script is:inline>
    const fallback = [
      {chapter_number:2,verse_number:47,text:"कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।",translation:"कर्म करने में ही तुम्हारा अधिकार है, उसके फल पर कभी नहीं।"},
      {chapter_number:2,verse_number:48,text:"योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनञ्जय।",translation:"हे धनंजय, आसक्ति छोड़कर समत्व-बुद्धि से कर्म करो।"},
      {chapter_number:4,verse_number:7,text:"यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।",translation:"हे भारत, जब-जब धर्म की हानि और अधर्म की वृद्धि होती है।"},
      {chapter_number:4,verse_number:8,text:"परित्राणाय साधूनां विनाशाय च दुष्कृताम्।",translation:"सज्जनों की रक्षा और दुष्कर्मियों के विनाश के लिए।"},
      {chapter_number:18,verse_number:66,text:"सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज।",translation:"सभी प्रकार के आश्रयों को छोड़कर केवल मेरी शरण में आओ।"}
    ];
    const ref = document.getElementById("daily-shlok-ref");
    const text = document.getElementById("daily-shlok-text");
    const meaning = document.getElementById("daily-shlok-meaning");
    const status = document.getElementById("daily-shlok-status");
    let currentVerse = fallback[0];

    const dayNumber = () => {
      const now = new Date();
      const start = new Date(now.getFullYear(), 0, 0);
      return Math.floor((now - start) / 86400000);
    };

    const applyDaily = (verses) => {
      if (!verses.length) return;
      currentVerse = verses[dayNumber() % verses.length];
      ref.textContent = `भगवद्गीता ${currentVerse.chapter_number}.${currentVerse.verse_number}`;
      text.textContent = currentVerse.text;
      meaning.textContent = currentVerse.translation || "हिंदी अर्थ उपलब्ध नहीं है।";
      status.textContent = `आज का चयन: श्लोक ${currentVerse.chapter_number}.${currentVerse.verse_number}`;
    };

    document.getElementById("daily-shlok-listen")?.addEventListener("click", () => {
      const speakText = `भगवद्गीता अध्याय ${currentVerse.chapter_number}, श्लोक ${currentVerse.verse_number}. ${currentVerse.text}. ${currentVerse.translation || ""}`;
      window.NexusSpeak?.(speakText);
    });

    document.getElementById("daily-shlok-copy")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(`भगवद्गीता ${currentVerse.chapter_number}.${currentVerse.verse_number}\n${currentVerse.text}\n${currentVerse.translation || ""}`.trim());
        status.textContent = "आज का श्लोक कॉपी हो गया।";
      } catch {
        status.textContent = "श्लोक कॉपी नहीं हो सका।";
      }
    });

    (async () => {
      try {
        const responses = await Promise.all(Array.from({length:18}, (_, i) => fetch(`https://raw.githubusercontent.com/gita/gita/master/data/json/chapter_${i+1}.json`)));
        if (responses.some(r => !r.ok)) throw new Error("remote unavailable");
        const payloads = await Promise.all(responses.map(r => r.json()));
        const verses = payloads.flatMap((payload, index) => {
          const items = Array.isArray(payload) ? payload : (payload.verses || payload.data || []);
          return items.map(v => ({
            chapter_number: Number(v.chapter_number ?? index + 1),
            verse_number: Number(v.verse_number ?? v.verse ?? v.id ?? 0),
            text: v.text ?? v.slok ?? v.sanskrit ?? "",
            translation: v.translation ?? v.hindi_translation ?? v.meaning ?? ""
          }));
        }).filter(v => v.text);
        applyDaily(verses.length ? verses : fallback);
      } catch {
        applyDaily(fallback);
        status.textContent = "पूरा संग्रह अभी उपलब्ध नहीं था; आज के लिए सुरक्षित fallback श्लोक दिखाया गया है।";
      }
    })();
  </script>
</Layout>