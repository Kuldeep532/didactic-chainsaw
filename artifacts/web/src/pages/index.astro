---
import Layout from "../layouts/Layout.astro";
import FeatureVisual from "../components/FeatureVisual.astro";
---
<Layout title="Nexus Wave Technologies" description="Nexus Wave Technologies — Nexus Plus, accessible digital tools, community, safety services and spiritual learning.">
  <section class="hero nexus-hero">
    <div class="container hero-shell">
      <div class="nexus-hero-copy scroll-reveal">
        <p class="eyebrow">Nexus Plus</p>
        <h1>Technology that feels <span class="gradient-text">simple, beautiful and useful.</span></h1>
        <p class="lead">Nexus Plus brings AI, audio, media, accessibility, community, safety and spiritual learning together in one welcoming experience.</p>
        <div class="actions">
          <a class="button primary" href="/apps">Explore Nexus apps</a>
          <a class="button" href="/shlok">Read Bhagavad Gita</a>
        </div>
        <div class="hero-badges" aria-label="Highlights">
          <span>Fast</span><span>Accessible</span><span>Privacy first</span>
        </div>
      </div>
      <div class="hero-visual-wrap scroll-reveal">
        <FeatureVisual type="gita" title="Nexus Plus" subtitle="AI · Audio · Media · Gita" />
        <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div><div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head scroll-reveal"><div><p class="eyebrow">Everything in one place</p><h2>Made to feel like a great app, not a technical dashboard.</h2></div></div>
      <div class="grid-4">
        <article class="card tilt-card shine scroll-reveal"><FeatureVisual type="spark" title="AI Tools" subtitle="Write · create · solve" /><h3>AI & everyday tools</h3><p class="muted">Helpful tools for writing, ideas, documents and everyday tasks.</p><a href="/apps">Explore AI tools</a></article>
        <article class="card tilt-card shine scroll-reveal"><FeatureVisual type="audio" title="Audio Studio" subtitle="Record · edit · listen" /><h3>Audio & listening</h3><p class="muted">Record, edit, compress and enjoy voice and spiritual audio.</p><a href="/apps">Explore audio</a></article>
        <article class="card tilt-card shine scroll-reveal"><FeatureVisual type="safety" title="Safety Center" subtitle="Help · support · privacy" /><h3>Women Safety</h3><p class="muted">Find safety information and reach private support when needed.</p><a href="/women-safety">Open Safety Center</a></article>
        <article class="card tilt-card shine scroll-reveal"><FeatureVisual type="community" title="Community" subtitle="Connect · share · learn" /><h3>Community</h3><p class="muted">A calmer place for useful conversations and shared ideas.</p><a href="/community">Visit community</a></article>
      </div>
    </div>
  </section>

  <section class="section surface-soft">
    <div class="container grid-3">
      <article class="card scroll-reveal"><p class="eyebrow">Nexus Plus</p><h2>Your everyday digital companion.</h2><p class="muted">AI, audio, video, notes, utilities, accessibility and more in one app.</p><a class="button primary" href="/apps#nexus-plus">See Nexus Plus</a></article>
      <article class="card scroll-reveal"><p class="eyebrow">Geeta Nexus</p><h2>Pause. Listen. Learn.</h2><p class="muted">Read and listen to spiritual wisdom in a clear, accessible experience.</p><a class="button" href="/shlok">Open Gita Nexus</a></article>
      <article class="card scroll-reveal"><p class="eyebrow">Join the Team</p><h2>Help make technology kinder.</h2><p class="muted">Accessibility, audio, community, safety and content contributions are welcome.</p><a class="button" href="/join-team">Join us</a></article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head scroll-reveal"><div><p class="eyebrow">Today's reading</p><h2>आज का श्लोक</h2></div><a class="button" href="/shlok">सभी श्लोक</a></div>
      <article class="card shlok-card scroll-reveal">
        <div><div class="shlok-badge">भगवद्गीता</div><p id="daily-shlok-ref" class="gita-ref">श्लोक लोड हो रहा है…</p><h3 id="daily-shlok-text" class="gita-sanskrit" lang="sa">कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।</h3><p id="daily-shlok-meaning" class="gita-meaning" lang="hi">कर्म करने में ही तुम्हारा अधिकार है, उसके फल पर नहीं।</p></div>
        <div class="actions"><button id="daily-shlok-listen" class="button primary" type="button">श्लोक सुनें</button><button id="daily-shlok-copy" class="button" type="button">कॉपी करें</button></div>
        <p id="daily-shlok-status" class="note" aria-live="polite">हर दिन एक नया श्लोक चुना जाता है।</p>
      </article>
    </div>
  </section>

  <section class="section surface-soft">
    <div class="container">
      <div class="cta-panel scroll-reveal">
        <div><p class="eyebrow">Nexus Plus</p><h2>Built with care for everyday life.</h2><p>Useful technology with a human touch—built for everyone.</p></div>
        <a class="button primary" href="/apps">Explore all features</a>
      </div>
    </div>
  </section>

  <script is:inline>
    const fallback=[{chapter_number:2,verse_number:47,text:"कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।",translation:"कर्म करने में ही तुम्हारा अधिकार है, उसके फल पर नहीं।"},{chapter_number:2,verse_number:48,text:"योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनञ्जय।",translation:"हे धनंजय, आसक्ति छोड़कर समत्व-बुद्धि से कर्म करो।"},{chapter_number:4,verse_number:7,text:"यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।",translation:"हे भारत, जब-जब धर्म की हानि और अधर्म की वृद्धि होती है।"},{chapter_number:18,verse_number:66,text:"सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज।",translation:"सभी प्रकार के आश्रयों को छोड़कर केवल मेरी शरण में आओ।"}];
    let currentVerse=fallback[0];
    const ref=document.getElementById("daily-shlok-ref"),text=document.getElementById("daily-shlok-text"),meaning=document.getElementById("daily-shlok-meaning"),status=document.getElementById("daily-shlok-status");
    const apply=verses=>{if(!verses.length)return;currentVerse=verses[Math.floor(Date.now()/86400000)%verses.length];ref.textContent=`भगवद्गीता ${currentVerse.chapter_number}.${currentVerse.verse_number}`;text.textContent=currentVerse.text;meaning.textContent=currentVerse.translation||"";};
    document.getElementById("daily-shlok-listen")?.addEventListener("click",()=>window.NexusSpeak?.(`भगवद्गीता अध्याय ${currentVerse.chapter_number}, श्लोक ${currentVerse.verse_number}. ${currentVerse.text}. ${currentVerse.translation||""}`));
    document.getElementById("daily-shlok-copy")?.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(`भगवद्गीता ${currentVerse.chapter_number}.${currentVerse.verse_number}\n${currentVerse.text}\n${currentVerse.translation||""}`);status.textContent="श्लोक कॉपी हो गया।";}catch{status.textContent="श्लोक कॉपी नहीं हो सका।";}});
    (async()=>{try{const responses=await Promise.all(Array.from({length:18},(_,i)=>fetch(`https://raw.githubusercontent.com/gita/gita/master/data/json/chapter_${i+1}.json`)));if(responses.some(r=>!r.ok))throw 0;const payloads=await Promise.all(responses.map(r=>r.json()));const verses=payloads.flatMap((p,i)=>(Array.isArray(p)?p:(p.verses||p.data||[])).map(v=>({chapter_number:Number(v.chapter_number??i+1),verse_number:Number(v.verse_number??v.verse??v.id??0),text:v.text??v.slok??v.sanskrit??"",translation:v.translation??v.hindi_translation??v.meaning??""}))).filter(v=>v.text);apply(verses.length?verses:fallback);}catch{apply(fallback);status.textContent="आज के लिए एक छोटा सुरक्षित संग्रह दिखाया गया है।";}})();
  </script>
  <style>
    .nexus-hero{position:relative;overflow:hidden;background:radial-gradient(circle at 78% 35%,rgb(99 102 241 / 14%),transparent 28%),radial-gradient(circle at 20% 30%,rgb(37 99 235 / 10%),transparent 28%)}
    .nexus-hero-copy{position:relative;z-index:2}.gradient-text{background:linear-gradient(90deg,#2563eb,#7c3aed 55%,#d97706);-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero-visual-wrap{position:relative;min-height:260px;display:grid;place-items:center}.hero-visual-wrap .feature-visual{width:min(100%,420px);min-height:270px;transform:perspective(1000px) rotateY(-5deg)}
    .hero-orbit{position:absolute;border:1px solid rgb(99 102 241 / 20%);border-radius:50%;pointer-events:none}.hero-orbit--one{width:330px;height:180px;transform:rotate(22deg)}.hero-orbit--two{width:250px;height:120px;transform:rotate(-34deg)}
    .hero-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.hero-badges span{padding:7px 10px;border:1px solid var(--color-border);border-radius:999px;background:color-mix(in srgb,var(--color-surface) 82%,transparent);font-size:12px;font-weight:700}
    .shlok-card{display:grid;gap:22px;background:linear-gradient(135deg,var(--color-surface-raised),color-mix(in srgb,#fef3c7 26%,var(--color-surface-raised)))}
    .shlok-badge{display:inline-flex;padding:6px 10px;border-radius:999px;background:#fff7d6;color:#8a5a00;font-size:12px;font-weight:800;margin-bottom:10px}
    .cta-panel{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:32px;border:1px solid color-mix(in srgb,#7c3aed 22%,var(--color-border));border-radius:24px;background:linear-gradient(120deg,color-mix(in srgb,#eff6ff 70%,var(--color-surface-raised)),color-mix(in srgb,#f5f3ff 72%,var(--color-surface-raised)));box-shadow:var(--shadow-2)}
    @media(max-width:639px){.hero-visual-wrap{min-height:230px}.hero-visual-wrap .feature-visual{min-height:220px;transform:none}.hero-badges{gap:6px}.cta-panel{display:grid;padding:24px}.shlok-card{padding:20px}}
    @media(prefers-reduced-motion:no-preference){.hero-orbit--one{animation:orbitFloat 8s ease-in-out infinite}.hero-orbit--two{animation:orbitFloat 6s ease-in-out infinite reverse}@keyframes orbitFloat{50%{transform:rotate(22deg) translateY(-6px)}}}
  </style>
</Layout>