---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Nexus Wave Technologies" description="Simple, accessible digital products, helpful services and spiritual learning.">
  <section class="hero">
    <div class="container hero-shell">
      <div>
        <p class="eyebrow">Nexus Wave Technologies</p>
        <h1>Technology that feels simple.</h1>
        <p class="lead">Accessible apps, helpful services, audio tools and spiritual learning—designed for real people.</p>
        <div class="actions">
          <a class="button primary" href="/apps">Explore apps & services</a>
          <a class="button" href="/women-safety">Women Safety</a>
        </div>
      </div>
      <div class="hero-panel">
        <p class="eyebrow">Made for people</p>
        <h2>Clear. Accessible. Useful.</h2>
        <p class="muted">Simple screens, readable controls and practical features across the Nexus experience.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">What you can do</p><h2>Start with what you need.</h2></div></div>
      <div class="grid-4">
        <article class="card"><h3>AI & everyday tools</h3><p class="muted">Get help with writing, ideas, documents and everyday tasks.</p><a href="/apps">Explore apps →</a></article>
        <article class="card"><h3>Audio & listening</h3><p class="muted">Record, edit and listen to voice and spiritual audio.</p><a href="/apps">Explore audio →</a></article>
        <article class="card"><h3>Women Safety</h3><p class="muted">Find immediate-help information and request private support.</p><a href="/women-safety">Open safety center →</a></article>
        <article class="card"><h3>Community</h3><p class="muted">A calmer place for useful conversations and shared ideas.</p><a href="/community">Visit community →</a></article>
      </div>
    </div>
  </section>

  <section class="section surface-soft">
    <div class="container grid-2">
      <article class="card">
        <p class="eyebrow">Nexus Plus</p>
        <h2>AI, audio, media and useful tools in one app.</h2>
        <p class="muted">Built to make everyday digital work easier, with accessibility at the center.</p>
        <a class="button primary" href="/apps#nexus-plus">See Nexus Plus</a>
      </article>
      <article class="card">
        <p class="eyebrow">Geeta Nexus</p>
        <h2>Read and listen at your own pace.</h2>
        <p class="muted">Explore Bhagavad Gita and other spiritual learning content in a clear, accessible experience.</p>
        <a class="button" href="/shlok">Read Bhagavad Gita</a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Today's reading</p><h2>आज का श्लोक</h2></div><a class="button" href="/shlok">सभी श्लोक</a></div>
      <article class="card">
        <p id="daily-shlok-ref" class="gita-ref">श्लोक लोड हो रहा है…</p>
        <h3 id="daily-shlok-text" class="gita-sanskrit" lang="sa">कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।</h3>
        <p id="daily-shlok-meaning" class="gita-meaning" lang="hi">कर्म करने में ही तुम्हारा अधिकार है, उसके फल पर नहीं।</p>
        <div class="actions">
          <button id="daily-shlok-listen" class="button primary" type="button">श्लोक सुनें</button>
          <button id="daily-shlok-copy" class="button" type="button">कॉपी करें</button>
        </div>
        <p id="daily-shlok-status" class="note" aria-live="polite">हर दिन एक नया श्लोक चुना जाता है।</p>
      </article>
    </div>
  </section>

  <section class="section surface-soft">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Join us</p><h2>Want to help build something useful?</h2><p class="muted">Record audio, translate, improve accessibility, join the Women Safety campaign or help the community.</p></div><a class="button primary" href="/join-team">Join the team</a></div>
    </div>
  </section>

  <script is:inline>
    const fallback=[{chapter_number:2,verse_number:47,text:"कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।",translation:"कर्म करने में ही तुम्हारा अधिकार है, उसके फल पर नहीं।"},{chapter_number:2,verse_number:48,text:"योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनञ्जय।",translation:"हे धनंजय, आसक्ति छोड़कर समत्व-बुद्धि से कर्म करो।"},{chapter_number:4,verse_number:7,text:"यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।",translation:"हे भारत, जब-जब धर्म की हानि और अधर्म की वृद्धि होती है।"},{chapter_number:18,verse_number:66,text:"सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज।",translation:"सभी प्रकार के आश्रयों को छोड़कर केवल मेरी शरण में आओ।"}];
    let currentVerse=fallback[0];
    const ref=document.getElementById("daily-shlok-ref"),text=document.getElementById("daily-shlok-text"),meaning=document.getElementById("daily-shlok-meaning"),status=document.getElementById("daily-shlok-status");
    const apply=verses=>{if(!verses.length)return;currentVerse=verses[Math.floor(Date.now()/86400000)%verses.length];ref.textContent=`भगवद्गीता ${currentVerse.chapter_number}.${currentVerse.verse_number}`;text.textContent=currentVerse.text;meaning.textContent=currentVerse.translation||"";};
    document.getElementById("daily-shlok-listen")?.addEventListener("click",()=>window.NexusSpeak?.(`भगवद्गीता अध्याय ${currentVerse.chapter_number}, श्लोक ${currentVerse.verse_number}. ${currentVerse.text}. ${currentVerse.translation||""}`));
    document.getElementById("daily-shlok-copy")?.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(`भगवद्गीता ${currentVerse.chapter_number}.${currentVerse.verse_number}\n${currentVerse.text}\n${currentVerse.translation||""}`);status.textContent="श्लोक कॉपी हो गया।";}catch{status.textContent="कॉपी नहीं हो सका।";}});
    (async()=>{try{const responses=await Promise.all(Array.from({length:18},(_,i)=>fetch(`https://raw.githubusercontent.com/gita/gita/master/data/json/chapter_${i+1}.json`)));if(responses.some(r=>!r.ok))throw 0;const payloads=await Promise.all(responses.map(r=>r.json()));const verses=payloads.flatMap((p,i)=>(Array.isArray(p)?p:(p.verses||p.data||[])).map(v=>({chapter_number:Number(v.chapter_number??i+1),verse_number:Number(v.verse_number??v.verse??v.id??0),text:v.text??v.slok??v.sanskrit??"",translation:v.translation??v.hindi_translation??v.meaning??""}))).filter(v=>v.text);apply(verses.length?verses:fallback);}catch{apply(fallback);status.textContent="आज के लिए एक छोटा सुरक्षित संग्रह दिखाया गया है।";}})();
  </script>
</Layout>
