---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Nexus Wave Technologies" description="Accessible software, AI, utilities and spiritual learning from Nexus Wave Technologies.">
  <section class="hero">
    <div class="container hero-shell">
      <div>
        <p class="eyebrow">Nexus Wave Technologies</p>
        <h1>User-friendly software. Built for real life.</h1>
        <p class="lead">Accessible digital products for productivity, AI, media, community and spiritual learning.</p>
        <div class="actions">
          <a class="button primary" href="/apps">Explore Nexus Apps</a>
          <a class="button" href="/utilities">Open Free Utilities</a>
        </div>
        <div class="grid-3" style="margin-top:1.5rem">
          <div class="stat"><strong>Accessible</strong><span class="muted">Screen-reader and keyboard-friendly UI</span></div>
          <div class="stat"><strong>Practical</strong><span class="muted">Useful tools without unnecessary complexity</span></div>
          <div class="stat"><strong>Connected</strong><span class="muted">Supabase-backed website services</span></div>
        </div>
      </div>
      <div class="hero-panel">
        <img src="/assets/hero-workspace.jpg" alt="Nexus workspace preview" />
        <p class="muted" style="margin:.8rem 0 0">A cleaner, responsive website foundation ready for the Nexus ecosystem.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Products</p><h2>Nexus Plus and Geeta Nexus</h2></div><a class="button ghost" href="/apps">View all apps</a></div>
      <div class="grid-2">
        <article class="card"><img src="/assets/nexus-plus-mockup.jpg" alt="Nexus Plus app preview" style="width:100%;border-radius:14px;margin-bottom:1rem" /><h3>Nexus Plus</h3><p class="muted">AI assistant, audio and media tools, PDF utilities, e-paper workflows and accessibility-focused features.</p><a class="button primary" href="/apps#nexus-plus">Explore Nexus Plus</a></article>
        <article class="card"><img src="/assets/geeta-nexus-mockup.jpg" alt="Geeta Nexus app preview" style="width:100%;border-radius:14px;margin-bottom:1rem" /><h3>Geeta Nexus</h3><p class="muted">Accessible Bhagavad Gita reading and spiritual learning with a clear, user-friendly experience.</p><a class="button" href="/apps#geeta-nexus">Explore Geeta Nexus</a></article>
      </div>
    </div>
  </section>
  <section class="section surface-soft">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Website services</p><h2>Everything in one simple place.</h2></div></div>
      <div class="grid-4">
        <article class="card"><h3>Utilities</h3><p class="muted">Fast browser-based text helpers.</p><a href="/utilities">Open utilities →</a></article>
        <article class="card"><h3>Community</h3><p class="muted">Community posts with accessible listening.</p><a href="/community">Open community →</a></article>
        <article class="card"><h3>Accounts</h3><p class="muted">Supabase-powered sign-in and account access.</p><a href="/login">Sign in →</a></article>
        <article class="card"><h3>Team</h3><p class="muted">Contribute through accessibility, audio, teaching and support.</p><a href="/join-team">Join the team →</a></article>
      </div>
    </div>
  </section>
</Layout>