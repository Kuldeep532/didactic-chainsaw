---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
const { data: articles } = supabase
  ? await supabase.from("articles").select("id,title,slug,category,excerpt,published_at").eq("published", true).order("published_at", { ascending: false }).limit(24)
  : { data: [] };
---
<Layout title="Articles — Nexus Wave Technologies" description="Articles and updates from Nexus Wave Technologies.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Articles</p>
      <h1>Useful updates from Nexus Wave.</h1>
      <p class="lead">Product updates, accessibility notes, practical guides and company news.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {articles?.length ? (
        <div class="grid-3">
          {articles.map((article) => (
            <article class="card">
              <p class="eyebrow">{article.category}</p>
              <h2>{article.title}</h2>
              <p class="muted">{article.excerpt}</p>
              <a class="button" href={"/articles/" + article.slug}>Read article</a>
            </article>
          ))}
        </div>
      ) : (
        <article class="card">
          <h2>Articles will appear here soon.</h2>
          <p class="muted">New articles are added directly to the website content store.</p>
        </article>
      )}
    </div>
  </section>
</Layout>