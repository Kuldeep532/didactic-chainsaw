---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Private Support — Nexus Wave Technologies" description="Private support entry for an opaque case invitation.">
  <section class="hero"><div class="container">
    <p class="eyebrow">Private support</p>
    <h1 id="support-title">Checking your private support link…</h1>
    <p id="support-message" class="lead">This page is intentionally minimal. A valid invitation token is required to open a case.</p>
    <div class="actions"><a class="button" href="/">Return to Nexus website</a></div>
  </div></section>
  <section class="section"><div class="container grid-3">
    <article class="card"><h3>Private chat</h3><p class="muted">Available when an approved support worker joins the case.</p></article>
    <article class="card"><h3>Voice support</h3><p class="muted">The future support flow can use WebRTC without publishing a personal phone number.</p></article>
    <article class="card"><h3>Notifications</h3><p class="muted">Case updates can be delivered through the app or the verified contact method on file.</p></article>
  </div></section>
</Layout>
<script is:inline>
const token=new URLSearchParams(location.search).get("token");
const title=document.getElementById("support-title");
const msg=document.getElementById("support-message");
if(!token){title.textContent="Private support link required";msg.textContent="Open the invitation link you received after submitting a private support request.";}
else{title.textContent="Private support session";msg.textContent="Your private invitation is checked before any case information is shown.";}
</script>