---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Privacy Choices — Nexus Wave Technologies">
  <section class="hero"><div class="container"><p class="eyebrow">Privacy</p><h1>Your privacy choices</h1><p class="lead">Use this page to learn how to request access, correction, deletion, restriction, portability or other privacy assistance.</p></div></section>
  <section class="section"><div class="container grid-2">
    <article class="card">
      <h2>Request help</h2>
      <p class="muted" style="margin-top:12px">Email <a href="mailto:info@nexusweb.co.in?subject=Privacy%20Request">info@nexusweb.co.in</a> and clearly describe what you are requesting. Please do not send passwords, OTPs, UPI PINs, recovery codes or payment-card numbers.</p>
      <p class="muted" style="margin-top:12px">We may need enough information to verify the request and protect your account.</p>
    </article>
    <article class="card">
      <h2>Account deletion</h2>
      <p class="muted" style="margin-top:12px">For Nexus accounts, use the in-app account deletion control when available. You can also contact us using the email above. Information we must retain for legal, security, accounting or transaction reasons may be kept for the required period.</p>
      <a class="button primary" href="/account">Open account page</a>
    </article>
  </div></section>
  <section class="section surface-soft"><div class="container"><article class="card"><h2>Privacy rights</h2><p class="muted" style="margin-top:12px">Depending on your location and applicable law, you may have rights to be informed, access information, correct it, request deletion, restrict processing, receive a portable copy, object to certain processing and withdraw consent where consent is the legal basis.</p><p class="muted" style="margin-top:12px">Read the full <a href="/legal/privacy">Privacy Policy</a> for details.</p></article></div></section>
</Layout>