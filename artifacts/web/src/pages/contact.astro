---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Contact — Nexus Wave Technologies">
  <section class="hero"><div class="container"><p class="eyebrow">Contact</p><h1>Let’s talk.</h1><p class="lead">Reach the Nexus Wave Technologies team for product, accessibility, partnership or support questions.</p></div></section>
  <section class="section"><div class="container grid-2"><div class="card"><p class="eyebrow">Contact details</p><h2>Get in touch</h2><p class="muted"><strong>Email:</strong> <a href="mailto:info@nexusweb.co.in">info@nexusweb.co.in</a></p><p class="muted"><strong>Community:</strong> Discord</p><p class="muted"><strong>Location:</strong> India · Global operations.</p></div><div class="card"><h2>Send a message</h2><form class="form" action="mailto:info@nexusweb.co.in" method="post" enctype="text/plain"><label>First name<input name="firstName" required /></label><label>Last name<input name="lastName" required /></label><label>Email<input type="email" name="email" required /></label><label>Subject<input name="subject" required /></label><label>Message<textarea name="message" minlength="10" required></textarea></label><button class="button primary" type="submit">Open email app</button></form></div></div></section>
</Layout>