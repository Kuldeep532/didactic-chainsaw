---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Posts — Nexus Wave Technologies" description="Nexus Wave Technologies posts: product updates, accessibility notes, guides and community highlights.">
  <section class="hero">
    <div class="container post-hero">
      <p class="eyebrow">Nexus Posts</p>
      <h1>Stories, updates and useful notes from Nexus.</h1>
      <p class="lead">Posts replace the old blog presentation. This is the public editorial space for Nexus Wave Technologies.</p>
    </div>
  </section>

  <section id="live-posts" class="section surface-soft" hidden>
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Latest from Nexus</p><h2>New posts</h2><p class="muted">Posts published by the Nexus team appear here automatically.</p></div></div>
      <div id="live-post-grid" class="grid-3"></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Latest posts</p><h2>Start here.</h2></div>
        <a class="button" href="/community">Visit Community</a>
      </div>
      <div class="grid-3">
        <article class="card post-card">
          <div class="post-meta"><span>Product</span><span>·</span><span>Nexus Plus</span></div>
          <h3>What is Nexus Plus?</h3>
          <p class="muted">Nexus Plus brings AI, media, document, audio and accessibility utilities together in one ecosystem.</p>
          <a class="button" href="#post-nexus-plus">Read post →</a>
        </article>
        <article class="card post-card">
          <div class="post-meta"><span>Accessibility</span><span>·</span><span>Design</span></div>
          <h3>Designing for independent use.</h3>
          <p class="muted">Accessible structure is more than large text: it includes focus, headings, predictable navigation and useful spoken feedback.</p>
          <a class="button" href="#post-accessibility">Read post →</a>
        </article>
        <article class="card post-card">
          <div class="post-meta"><span>Community</span><span>·</span><span>Current direction</span></div>
          <h3>Why some community features are paused.</h3>
          <p class="muted">The current website keeps public community simple while future chat and member workflows are redesigned.</p>
          <a class="button" href="#post-community">Read post →</a>
        </article>
        <article class="card post-card">
          <div class="post-meta"><span>Safety</span><span>·</span><span>Women Safety</span></div>
          <h3>Building support pathways responsibly.</h3>
          <p class="muted">A digital support feature should explain its limits clearly and never pretend to replace emergency services.</p>
          <a class="button" href="#post-safety">Read post →</a>
        </article>
        <article class="card post-card">
          <div class="post-meta"><span>Geeta Nexus</span><span>·</span><span>Spiritual learning</span></div>
          <h3>Making daily learning easier to return to.</h3>
          <p class="muted">Daily shlok experiences can combine accessible reading, listening and simple navigation.</p>
          <a class="button" href="#post-gita">Read post →</a>
        </article>
        <article class="card post-card">
          <div class="post-meta"><span>Team</span><span>·</span><span>Contribution</span></div>
          <h3>Ways to contribute to Nexus.</h3>
          <p class="muted">Accessibility QA, audio, translation, teaching, safety content and community organization are all useful contribution paths.</p>
          <a class="button" href="/join-team">Join the team →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section surface-soft">
    <div class="container post-hero">
      <article id="post-nexus-plus" class="section-card" style="margin-bottom:1rem">
        <p class="eyebrow">Product</p><h2>What is Nexus Plus?</h2>
        <p class="muted">Nexus Plus is designed as an all-in-one environment for AI assistance, audio editing, media handling, document utilities, accessibility workflows and other practical tools. The public website presents the product in broad categories while detailed feature controls remain inside the product itself.</p>
      </article>
      <article id="post-accessibility" class="section-card" style="margin-bottom:1rem">
        <p class="eyebrow">Accessibility</p><h2>Designing for independent use.</h2>
        <p class="muted">Good accessibility combines semantic structure, clear focus, keyboard support, meaningful labels, readable layouts and controls that do not surprise the user. These principles guide the Nexus web experience alongside the Android products.</p>
      </article>
      <article id="post-community" class="section-card" style="margin-bottom:1rem">
        <p class="eyebrow">Community</p><h2>Why some community features are paused.</h2>
        <p class="muted">The public Community page is intentionally smaller than the underlying future community model. Chat and member messaging are disabled for now, while Posts remains the public content layer. This keeps unfinished interactions out of the main website.</p>
      </article>
      <article id="post-safety" class="section-card" style="margin-bottom:1rem">
        <p class="eyebrow">Safety</p><h2>Building support pathways responsibly.</h2>
        <p class="muted">The Women Safety Center provides an additional reporting and awareness route. It clearly states that the website is not an emergency service and that urgent situations should use local emergency help first.</p>
      </article>
      <article id="post-gita" class="section-card">
        <p class="eyebrow">Geeta Nexus</p><h2>Making daily learning easier to return to.</h2>
        <p class="muted">The website includes an accessible daily shlok experience so visitors can read, listen and continue into the broader Geeta Nexus reader.</p>
      </article>
    </div>
  </section>
</Layout>
<script>
  const loadPublishedPosts = async () => {
    const { browserSupabase } = await import("../lib/browser-auth");
    const section=document.getElementById("live-posts"),grid=document.getElementById("live-post-grid");
    if(!section||!grid||!browserSupabase)return;
    const {data}=await browserSupabase.from("site_posts").select("id,title,category,excerpt,body,slug,created_at").eq("published",true).order("created_at",{ascending:false}).limit(12);
    if(!data?.length){section.hidden=true;return;}
    grid.replaceChildren();
    for(const post of data){
      const card=document.createElement("article");card.className="card";
      const category=document.createElement("p");category.className="eyebrow";category.textContent=post.category||"Nexus";
      const title=document.createElement("h3");title.textContent=post.title;
      const excerpt=document.createElement("p");excerpt.className="muted";excerpt.textContent=post.excerpt||post.body.slice(0,180);
      card.append(category,title,excerpt);
      grid.append(card);
    }
    section.hidden=false;
  };
  document.addEventListener("astro:page-load",()=>setTimeout(loadPublishedPosts,300));
  setTimeout(loadPublishedPosts,300);
</script>
