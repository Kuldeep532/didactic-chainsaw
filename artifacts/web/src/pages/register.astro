---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Create an Account — Nexus Wave Technologies" description="Create your Nexus Wave Technologies account.">
  <section class="hero"><div class="container"><p class="eyebrow">Nexus Account</p><h1>Create your account</h1><p class="lead">Use your Nexus account to access community features, private support and other account-based services.</p></div></section>
  <section class="section"><div class="container"><div class="card" style="max-width:620px;margin:auto">
    <h2>Ready to join?</h2><p class="muted">Registration is handled securely through Nexus account sign-in.</p>
    <div class="actions"><a class="button primary" href="/login">Create account / Log in</a><a class="button" href="/help">Need help?</a></div>
  </div></div></section>
</Layout>