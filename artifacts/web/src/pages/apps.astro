---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Apps & Services — Nexus Wave Technologies" description="Explore Nexus Plus, Geeta Nexus and the digital services offered by Nexus Wave Technologies.">
  <section class="hero"><div class="container"><p class="eyebrow">Products & services</p><h1>Clear product information before you buy.</h1><p class="lead">Explore what each product does, which features are free, and which advanced features may require a paid plan or usage credits.</p></div></section>

  <section class="section"><div class="container grid-2">
    <article class="card" id="nexus-plus">
      <img src="/assets/nexus-plus-mockup.jpg" alt="Nexus Plus app preview" style="width:100%;border-radius:16px;margin-bottom:18px" />
      <p class="eyebrow">Main product</p><h2>Nexus Plus</h2>
      <p class="muted">An accessible Android-focused platform bringing AI, audio, media, documents, utilities and other everyday workflows together.</p>
      <h3 style="margin-top:20px">Included capabilities</h3>
      <ul class="feature-list"><li>AI assistance and productivity tools</li><li>Audio recording and editing workflows</li><li>Document and PDF utilities</li><li>Media and accessibility-focused features</li><li>Free and premium capabilities clearly identified in the app</li></ul>
      <a class="button primary" href="/business">View product and plan information</a>
    </article>

    <article class="card">
      <img src="/assets/geeta-nexus-mockup.jpg" alt="Geeta Nexus app preview" style="width:100%;border-radius:16px;margin-bottom:18px" />
      <p class="eyebrow">Spiritual learning</p><h2>Geeta Nexus</h2>
      <p class="muted">A focused spiritual-learning experience built around accessible reading and listening.</p>
      <h3 style="margin-top:20px">Included capabilities</h3>
      <ul class="feature-list"><li>Bhagavad Gita reading</li><li>Daily shlok experience</li><li>Hindi and English learning support</li><li>Accessible navigation and listening</li></ul>
      <a class="button primary" href="/shlok">Open Bhagavad Gita</a>
    </article>
  </div></section>

  <section class="section surface-soft"><div class="container"><div class="section-head"><div><p class="eyebrow">Free access</p><h2>What stays available without a paid purchase?</h2></div></div><div class="grid-3">
    <article class="card"><h3>Core utilities</h3><p class="muted">Designated basic tools and public website information remain free unless a page explicitly says otherwise.</p></article>
    <article class="card"><h3>Spiritual learning</h3><p class="muted">Geeta Nexus reading and spiritual content are presented separately from paid AI billing.</p></article>
    <article class="card"><h3>Product information</h3><p class="muted">You can review product, pricing and legal information before entering a payment flow.</p></article>
  </div></div></section>

  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Premium access</p><h2>Paid features and AI usage</h2></div></div><div class="grid-3">
    <article class="card"><h3>Premium plans</h3><p class="muted">Subscription access may be offered for selected premium capabilities. The exact plan, billing period and price are shown before confirmation.</p></article>
    <article class="card"><h3>AI credits</h3><p class="muted">Some metered AI capabilities may use usage credits. The amount and applicable price are presented before purchase.</p></article>
    <article class="card"><h3>No hidden billing</h3><p class="muted">Customers should see the product, price, currency, billing period and applicable purchase terms before they confirm a payment.</p></article>
  </div><p class="note" style="margin-top:18px">For current plan, payment and refund information, see <a href="/business">Products & Plans</a> and <a href="/legal/refund">Refund Policy</a>.</p></div></section>
</Layout>
