---
import Layout from "../layouts/Layout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<Layout title="Admin — Nexus Wave Technologies" description="Restricted administration and verification controls.">
  <section class="section"><div class="container">
    <div class="page-title-row"><div><p class="eyebrow">Restricted workspace</p><h1 class="page-title">Admin Control Center</h1><p class="lead">Verification, moderation, team authorization and community safety controls.</p></div><a class="button" href="/dashboard">Dashboard</a></div>
    <div id="admin-gate" class="card"><p class="muted">Checking administrator access…</p></div>
    <div id="admin-console" hidden>
      <div class="admin-grid">
        <article class="card"><p class="eyebrow">Verification</p><h3>Pending reviews</h3><p class="muted">Approve or reject account verification requests.</p><button class="button primary" type="button" data-action="verification">Open queue</button></article>
        <article class="card"><p class="eyebrow">Moderation</p><h3>Community safety</h3><p class="muted">Review reports, hateful content and user submissions before publication.</p><button class="button" type="button" data-action="moderation">Open moderation</button></article>
        <article class="card"><p class="eyebrow">Team</p><h3>Authorized publishers</h3><p class="muted">Only approved team roles can publish official blog posts or other official content.</p><button class="button" type="button" data-action="team">Manage team</button></article>
      </div>
      <section class="section-card" style="margin-top:1rem">
        <p class="eyebrow">Role model</p><h2>How to define an admin</h2>
        <p class="muted">Create a server-controlled profile role such as <code>admin</code> and protect every privileged query and mutation with RLS or an Edge Function. Do not rely on a client-side flag, hidden menu or email address check alone.</p>
        <pre class="code-block"><code>profiles.role = 'admin'
profiles.verification_status = 'verified'
team_members.role IN ('team_editor','moderator','admin')</code></pre>
        <p class="note">The initial super-admin should be inserted through a one-time server-side SQL/admin migration or Supabase dashboard using an audited account. Never expose the service-role key in the website.</p>
      </section>
      <section class="section-card" style="margin-top:1rem">
        <p class="eyebrow">Verification</p><h2>Privacy-preserving account verification</h2>
        <p class="muted">Use verified account identity, age/safety requirements and moderator review where needed. Do not attempt to infer a person’s gender from a face, voice or other biometric signal. For gender-specific communities, grant access according to the platform's declared membership category plus a documented review process, minimizing retained evidence.</p>
      </section>
    </div>
  </div></section>
</Layout>
<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
  const gate=document.getElementById("admin-gate"), consolePanel=document.getElementById("admin-console");
  async function check(){
    if(!supabaseUrl||!supabaseKey){gate.innerHTML='<p class="note">Supabase is not configured.</p>';return}
    try{
      const r=await fetch(supabaseUrl+"/rest/v1/profiles?select=id,role,verification_status&limit=1",{headers:{apikey:supabaseKey,Authorization:"Bearer "+supabaseKey}});
      if(!r.ok) throw 0;
      const rows=await r.json(); const profile=rows[0];
      if(profile?.role!=="admin"){gate.innerHTML='<h2>Access restricted</h2><p class="muted">This workspace is available only to administrators.</p>';return}
      gate.innerHTML='<h2>Administrator access confirmed</h2><p class="muted">Privileged console unlocked.</p>';consolePanel.hidden=false;
    }catch{gate.innerHTML='<p class="note">Administrator verification is not connected yet. Keep privileged access server-enforced in Supabase.</p>'}
  }
  check();
</script>