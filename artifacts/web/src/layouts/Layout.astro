---
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AutoLinks from "../components/AutoLinks.astro";
import NexusLogo from "../components/NexusLogo.astro";
const path = Astro.url.pathname;
const linkScreen = path === "/" ? "home" : path.replace(/^\//, "").split("/")[0] || "home";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={Astro.props.description ?? "Nexus Wave Technologies — simple, accessible digital products and services."} />
    <meta name="theme-color" content="#2563eb" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{Astro.props.title ?? "Nexus Wave Technologies"}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("nexus-theme");
          document.documentElement.dataset.theme =
            saved === "dark" || saved === "light"
              ? saved
              : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <style is:global>
      /* =========================================================
         Nexus Design System
         8px spacing grid • semantic tokens • mobile first
         ========================================================= */
      :root {
        color-scheme: light;
        --color-bg: #f8fafc;
        --color-surface: #ffffff;
        --color-surface-raised: #ffffff;
        --color-surface-soft: #f1f5f9;
        --color-surface-accent: #eff6ff;
        --color-text: #172033;
        --color-text-muted: #5f6b7a;
        --color-text-subtle: #7a8798;
        --color-border: #d9e1ec;
        --color-border-strong: #b8c5d6;
        --color-primary: #2563eb;
        --color-primary-hover: #1d4ed8;
        --color-primary-active: #1e40af;
        --color-primary-soft: #dbeafe;
        --color-on-primary: #ffffff;
        --color-success: #147a52;
        --color-danger: #b42318;
        --color-warning: #9a6700;
        --shadow-1: 0 1px 2px rgb(15 23 42 / 6%), 0 4px 12px rgb(15 23 42 / 4%);
        --shadow-2: 0 4px 8px rgb(15 23 42 / 7%), 0 12px 28px rgb(15 23 42 / 7%);
        --shadow-3: 0 12px 24px rgb(15 23 42 / 10%), 0 24px 56px rgb(15 23 42 / 9%);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 20px;
        --space-6: 24px;
        --space-8: 32px;
        --space-10: 40px;
        --space-12: 48px;
        --space-16: 64px;
        --space-20: 80px;
        --container: 1200px;
        --header-height: 72px;
        --font-sans: Inter, Roboto, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --text-xs: 0.75rem;
        --text-sm: 0.875rem;
        --text-md: 1rem;
        --text-lg: 1.125rem;
        --text-xl: 1.25rem;
        --text-2xl: 1.5rem;
        --text-3xl: 2rem;
        --text-4xl: clamp(2.25rem, 7vw, 4.5rem);
        --line-tight: 1.12;
        --line-normal: 1.55;
        --line-relaxed: 1.7;
        --ease-standard: 180ms cubic-bezier(.2, 0, 0, 1);
        --ease-emphasized: 260ms cubic-bezier(.2, 0, 0, 1);
      }

      html[data-theme="dark"] {
        color-scheme: dark;
        --color-bg: #0b1220;
        --color-surface: #111a2b;
        --color-surface-raised: #162238;
        --color-surface-soft: #131e31;
        --color-surface-accent: #132b4f;
        --color-text: #f3f6fc;
        --color-text-muted: #b1bdd0;
        --color-text-subtle: #8f9db1;
        --color-border: #2a3950;
        --color-border-strong: #3b4d67;
        --color-primary: #75a9ff;
        --color-primary-hover: #91bbff;
        --color-primary-active: #b1ceff;
        --color-primary-soft: #18345d;
        --color-on-primary: #08111f;
        --color-success: #5dd39e;
        --color-danger: #ff9187;
        --color-warning: #f5c86c;
        --shadow-1: 0 1px 2px rgb(0 0 0 / 22%), 0 4px 12px rgb(0 0 0 / 15%);
        --shadow-2: 0 4px 10px rgb(0 0 0 / 24%), 0 12px 28px rgb(0 0 0 / 20%);
        --shadow-3: 0 16px 36px rgb(0 0 0 / 30%), 0 28px 60px rgb(0 0 0 / 22%);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        scroll-behavior: smooth;
        background: var(--color-bg);
        text-rendering: optimizeLegibility;
        -webkit-text-size-adjust: 100%;
      }

      body {
        min-width: 320px;
        margin: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: var(--text-md);
        font-weight: 400;
        line-height: var(--line-normal);
        transition: background-color var(--ease-standard), color var(--ease-standard);
      }

      h1,
      h2,
      h3,
      h4 {
        margin: 0;
        color: var(--color-text);
        font-weight: 700;
        line-height: var(--line-tight);
        letter-spacing: -0.02em;
      }

      h1 { font-size: var(--text-4xl); }
      h2 { font-size: var(--text-3xl); }
      h3 { font-size: var(--text-xl); }
      h4 { font-size: var(--text-lg); }

      p {
        margin: 0;
      }

      a {
        color: var(--color-primary);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: color var(--ease-standard), background-color var(--ease-standard);
      }

      a:hover {
        color: var(--color-primary-hover);
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button,
      a,
      input,
      textarea,
      select,
      summary {
        -webkit-tap-highlight-color: transparent;
      }

      button:focus-visible,
      a:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible,
      summary:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--color-primary) 32%, transparent);
        outline-offset: 2px;
      }

      img,
      svg,
      video {
        display: block;
        max-width: 100%;
      }

      img {
        height: auto;
      }

      .container {
        width: min(calc(100% - var(--space-4) * 2), var(--container));
        margin-inline: auto;
      }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid color-mix(in srgb, var(--color-border) 88%, transparent);
        background: color-mix(in srgb, var(--color-surface) 94%, transparent);
        backdrop-filter: blur(16px) saturate(140%);
      }

      .site-header-inner {
        min-height: var(--header-height);
        display: flex;
        align-items: center;
        gap: var(--space-4);
      }

      .nexus-brand{min-width:0}.brand {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: var(--space-3);
        flex: 0 0 auto;
        min-height: 48px;
        color: var(--color-text);
        font-size: var(--text-md);
        font-weight: 750;
        letter-spacing: -0.02em;
        text-decoration: none;
        white-space: nowrap;
      }

      .brand:hover {
        color: var(--color-text);
        text-decoration: none;
      }

      .brand-text{display:inline-flex}.brand-mark {
        width: 40px;
        height: 40px;
        display: grid;
        flex: 0 0 40px;
        place-items: center;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, var(--color-primary), #7c3aed);
        box-shadow: var(--shadow-1);
      }

      .brand-mark span {
        width: 15px;
        height: 15px;
        border: 3px solid #fff;
        border-radius: 50%;
      }

      .desktop-nav {
        display: none;
        align-items: center;
        gap: var(--space-1);
        margin-left: auto;
      }

      .desktop-nav > a,
      .nav-dropdown > summary {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        font-weight: 650;
        cursor: pointer;
        list-style: none;
        text-decoration: none;
      }

      .desktop-nav > a:hover,
      .nav-dropdown > summary:hover,
      .desktop-nav > a[aria-current="page"] {
        background: var(--color-surface-soft);
        color: var(--color-text);
        text-decoration: none;
      }

      .nav-dropdown {
        position: relative;
      }

      .nav-dropdown > summary::-webkit-details-marker {
        display: none;
      }

      .dropdown-panel {
        position: absolute;
        top: calc(100% + var(--space-2));
        right: 0;
        min-width: 240px;
        display: grid;
        gap: var(--space-1);
        padding: var(--space-2);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-raised);
        box-shadow: var(--shadow-3);
      }

      .dropdown-panel a {
        min-height: 44px;
        display: flex;
        align-items: center;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        font-size: var(--text-sm);
        text-decoration: none;
      }

      .dropdown-panel a:hover {
        background: var(--color-primary-soft);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-left: auto;
      }

      .icon-button,
      .mobile-menu-button {
        min-width: 44px;
        min-height: 44px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface);
        color: var(--color-text);
        cursor: pointer;
        transition: border-color var(--ease-standard), background-color var(--ease-standard), transform var(--ease-standard);
      }

      .icon-button:hover,
      .mobile-menu-button:hover {
        border-color: var(--color-border-strong);
        background: var(--color-surface-soft);
      }

      .mobile-menu-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .mobile-nav {
        display: grid;
        gap: var(--space-1);
        padding: var(--space-3) 0 var(--space-4);
      }

      .mobile-nav a {
        min-height: 44px;
        display: flex;
        align-items: center;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        font-weight: 650;
        text-decoration: none;
      }

      .mobile-nav a:hover {
        background: var(--color-surface-soft);
      }

      /* Page structure */
      .hero {
        padding: var(--space-16) 0 var(--space-12);
      }

      .hero-shell {
        display: grid;
        gap: var(--space-8);
        align-items: center;
      }

      .hero h1 {
        max-width: 900px;
        margin-top: var(--space-2);
        letter-spacing: -0.055em;
      }

      .hero .lead {
        max-width: 760px;
        margin-top: var(--space-4);
        color: var(--color-text-muted);
        font-size: var(--text-lg);
        line-height: var(--line-relaxed);
      }

      .hero-panel {
        padding: var(--space-6);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        background: var(--color-surface-raised);
        box-shadow: var(--shadow-2);
      }

      .section {
        padding: var(--space-12) 0;
      }

      .surface-soft {
        background: var(--color-surface-soft);
      }

      .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-6);
        margin-bottom: var(--space-6);
      }

      .section-head h2 {
        margin-top: var(--space-2);
      }

      .eyebrow {
        margin: 0 0 var(--space-2);
        color: var(--color-primary);
        font-size: var(--text-xs);
        font-weight: 800;
        letter-spacing: 0.12em;
        line-height: 1.3;
        text-transform: uppercase;
      }

      .muted {
        color: var(--color-text-muted);
      }

      .note {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        line-height: var(--line-relaxed);
      }

      /* Responsive grids */
      .grid-2,
      .grid-3,
      .grid-4 {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }

      /* Cards */
      .card,
      .section-card,
      .stat {
        min-width: 0;
        padding: var(--space-6);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-surface-raised);
        box-shadow: var(--shadow-1);
        transition: transform var(--ease-emphasized), border-color var(--ease-standard), box-shadow var(--ease-emphasized), background-color var(--ease-standard);
      }

      .card:hover,
      .section-card:hover {
        border-color: var(--color-border-strong);
        box-shadow: var(--shadow-2);
      }

      .stat {
        display: grid;
        gap: var(--space-1);
      }

      /* Actions and buttons */
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-top: var(--space-6);
      }

      .button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface);
        color: var(--color-text);
        font-size: var(--text-sm);
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 1px 1px rgb(15 23 42 / 4%);
        transition: transform var(--ease-standard), background-color var(--ease-standard), border-color var(--ease-standard), color var(--ease-standard), box-shadow var(--ease-standard);
      }

      .button:hover {
        border-color: var(--color-border-strong);
        background: var(--color-surface-soft);
        color: var(--color-text);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: var(--shadow-1);
      }

      .button:active {
        transform: translateY(0);
        box-shadow: none;
      }

      .button.primary {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: var(--color-on-primary);
        box-shadow: 0 2px 5px color-mix(in srgb, var(--color-primary) 24%, transparent);
      }

      .button.primary:hover {
        border-color: var(--color-primary-hover);
        background: var(--color-primary-hover);
        color: var(--color-on-primary);
      }

      .button.primary:active {
        background: var(--color-primary-active);
      }

      .button.ghost {
        border-color: transparent;
        background: transparent;
        box-shadow: none;
      }

      .button.ghost:hover {
        background: var(--color-surface-soft);
      }

      /* Forms */
      .form {
        display: grid;
        gap: var(--space-4);
      }

      .form label {
        display: grid;
        gap: var(--space-2);
        color: var(--color-text);
        font-size: var(--text-sm);
        font-weight: 650;
      }

      .form input,
      .form textarea,
      .form select,
      .reader-toolbar input,
      .reader-toolbar select {
        width: 100%;
        min-height: 44px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        padding: var(--space-2) var(--space-3);
        background: var(--color-surface);
        color: var(--color-text);
        font: inherit;
        line-height: 1.45;
        transition: border-color var(--ease-standard), box-shadow var(--ease-standard), background-color var(--ease-standard);
      }

      .form textarea {
        min-height: 136px;
        resize: vertical;
      }

      .form input:hover,
      .form textarea:hover,
      .form select:hover {
        border-color: var(--color-border-strong);
      }

      .form input:focus-visible,
      .form textarea:focus-visible,
      .form select:focus-visible,
      .reader-toolbar input:focus-visible,
      .reader-toolbar select:focus-visible {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 18%, transparent);
        outline: none;
      }

      .checkbox-row {
        display: flex !important;
        align-items: flex-start;
        gap: var(--space-2);
      }

      .checkbox-row input {
        width: auto;
        min-height: auto;
        margin-top: 5px;
      }

      .feature-list {
        margin: var(--space-4) 0 0;
        padding-left: var(--space-6);
      }

      .feature-list li {
        margin: var(--space-2) 0;
      }

      .scroll-reveal{opacity:0;transform:translateY(14px);transition:opacity 420ms var(--ease-emphasized),transform 420ms var(--ease-emphasized)}.scroll-reveal.is-visible{opacity:1;transform:none}.tilt-card{transform:translateZ(0);transition:transform 220ms var(--ease-emphasized),box-shadow 220ms var(--ease-emphasized)}.tilt-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-2)}.shine{position:relative;overflow:hidden}.shine::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(110deg,transparent 20%,rgb(255 255 255 / 18%) 46%,transparent 70%);transform:translateX(-120%)}@media (prefers-reduced-motion:no-preference){.shine::after{animation:lightSweep 6s ease-in-out infinite}}@keyframes lightSweep{0%,55%{transform:translateX(-120%)}75%,100%{transform:translateX(120%)}}

      /* Accessibility */
      .skip-link {
        position: fixed;
        left: var(--space-3);
        top: -100px;
        z-index: 100;
        padding: var(--space-3) var(--space-4);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface);
        color: var(--color-text);
        box-shadow: var(--shadow-2);
      }

      .skip-link:focus {
        top: var(--space-3);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Footer */
      .site-footer {
        margin-top: var(--space-12);
        padding: var(--space-12) 0 var(--space-5);
        border-top: 1px solid var(--color-border);
        background: var(--color-surface);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-8);
      }

      .footer-links {
        display: grid;
        align-content: start;
        gap: var(--space-2);
      }

      .footer-links strong {
        margin-bottom: var(--space-1);
      }

      .footer-social {
        display: flex;
        gap: var(--space-2);
        margin-top: var(--space-4);
      }

      .footer-social a {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        text-decoration: none;
        transition: border-color var(--ease-standard), background-color var(--ease-standard), transform var(--ease-standard);
      }

      .footer-social a:hover {
        border-color: var(--color-border-strong);
        background: var(--color-surface-soft);
        transform: translateY(-1px);
      }

      .footer-bottom {
        margin-top: var(--space-8);
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
      }

      .auto-links {
        padding-top: var(--space-6);
      }

      .auto-links .section-head {
        margin-bottom: var(--space-4);
      }

      [hidden] {
        display: none !important;
      }

      /* Tablet */
      @media (min-width: 640px) {
        .container {
          width: min(calc(100% - var(--space-8) * 2), var(--container));
        }

        .grid-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .grid-3,
        .grid-4 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer-grid {
          grid-template-columns: 1.7fr 1fr 1.2fr;
        }
      }

      /* Desktop */
      @media (min-width: 960px) {
        .desktop-nav {
          display: flex;
        }

        .mobile-menu-button {
          display: none;
        }

        .hero-shell {
          grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
          gap: var(--space-10);
        }

        .grid-3 {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .grid-4 {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      @media (max-width: 959px) {
        .desktop-nav {
          display: none;
        }

        .mobile-menu-button {
          display: inline-flex;
        }
      }

      @media (max-width: 639px) {
        .site-header-inner {
          min-height: 64px;
        }

        .brand-text {
          font-size: var(--text-sm);
        }

        .hero {
          padding: var(--space-12) 0 var(--space-8);
        }

        .hero .lead {
          font-size: var(--text-md);
        }

        .section {
          padding: var(--space-10) 0;
        }

        .section-head {
          display: grid;
          align-items: start;
          gap: var(--space-3);
        }

        .card,
        .section-card,
        .stat {
          padding: var(--space-5);
        }

        .actions {
          display: grid;
          grid-template-columns: 1fr;
        }

        .actions .button {
          width: 100%;
        }

        .header-actions .button:not(.primary):not(.theme-toggle) {
          padding-inline: var(--space-3);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header" data-site-header>
      <div class="container site-header-inner">
        <a class="brand nexus-brand" href="/" aria-label="Nexus Wave Technologies home"><span class="brand-text">Nexus Wave Technologies</span></a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
          <a href="/apps" aria-current={path.startsWith("/apps") ? "page" : undefined}>Apps</a>
          <a href="/tools" aria-current={path.startsWith("/tools") ? "page" : undefined}>Tools</a>
          <a href="/about" aria-current={path.startsWith("/about") ? "page" : undefined}>About</a>
        </nav>
        <div class="header-actions">
          <ThemeToggle />
          <button class="mobile-menu-button button" type="button" aria-expanded="false" aria-controls="mobile-nav" data-i18n="nav.menu">Menu</button>
        </div>
      </div>
      <nav id="mobile-nav" hidden class="container mobile-nav" aria-label="Mobile navigation">
        <a href="/">Home</a><a href="/apps">Apps</a><a href="/tools">Tools</a><a href="/about">About</a><a href="/shlok">Gita Nexus</a><a href="/contact">Contact</a>
        
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <AutoLinks screen={linkScreen} />
    <SiteFooter />
    <script>
      import { applyTranslations } from "../lib/i18n";
      const initShell = () => {
        applyTranslations();
        const mobileButton = document.querySelector(".mobile-menu-button");
        const mobileNav = document.getElementById("mobile-nav");
        if (mobileButton && !mobileButton.hasAttribute("data-ready")) {
          mobileButton.setAttribute("data-ready", "true");
          mobileButton.addEventListener("click", () => {
            const expanded = mobileButton.getAttribute("aria-expanded") === "true";
            mobileButton.setAttribute("aria-expanded", String(!expanded));
            if (mobileNav) mobileNav.hidden = expanded;
          });
        }
      };
      document.addEventListener("astro:page-load", initShell);
      initShell();
      const initMotion = () => { document.querySelectorAll(".scroll-reveal:not([data-motion-ready])").forEach((el) => { el.dataset.motionReady = "1"; if (!("IntersectionObserver" in window)) { el.classList.add("is-visible"); return; } const io = new IntersectionObserver((entries, obs) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-visible"); obs.unobserve(entry.target); } }), { rootMargin: "0px 0px -10% 0px" }); io.observe(el); }); }; document.addEventListener("astro:page-load", initMotion); initMotion();
      window.NexusSpeak = (text) => {
        if (!("speechSynthesis" in window)) return;
        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
      };
    </script>
  </body>
</html>
