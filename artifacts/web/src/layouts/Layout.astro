---
import ThemeToggle from "../components/ThemeToggle.astro";
import SiteFooter from "../components/SiteFooter.astro";
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={Astro.props.description ?? "Accessible digital products from Nexus Wave Technologies."} />
    <meta name="theme-color" content="#0f4c81" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{Astro.props.title ?? "Nexus Wave Technologies"}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("nexus-theme");
          document.documentElement.dataset.theme =
            saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href="/" aria-label="Nexus Wave Technologies home">
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span class="brand-text">Nexus Wave Technologies</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
          <a href="/apps" aria-current={path.startsWith("/apps") ? "page" : undefined}>Apps</a>
          <details class="nav-dropdown">
            <summary>Explore</summary>
            <div class="dropdown-panel">
              <a href="/shlok">श्लोक</a><a href="/women-safety">Women Safety</a>
              <a href="/utilities">Utilities</a>
              <a href="/community">Community</a><a href="/posts">Posts</a><a href="/notifications">Notifications</a><a href="/notifications">Notifications</a>
              <a href="/join-team">Join Our Team</a>
              <a href="/contact">Contact</a>
            </div>
          </details>
          <a href="/about" aria-current={path.startsWith("/about") ? "page" : undefined}>About</a>
        </nav>
        <div class="header-actions">
          <ThemeToggle />
          <button class="mobile-menu-button button" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
        </div>
      </div>
      <nav id="mobile-nav" hidden class="container mobile-nav" aria-label="Mobile navigation">
        <a href="/">Home</a><a href="/apps">Apps</a><a href="/shlok">श्लोक</a><a href="/utilities">Utilities</a><a href="/community">Community</a><a href="/posts">Posts</a><a href="/about">About</a><a href="/join-team">Join Our Team</a>
        <a href="/contact">Contact</a><a href="/women-safety">Women Safety</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <script is:inline>
      window.NexusSpeak = (text) => {
        if (!("speechSynthesis" in window)) return;
        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
      };
      const mobileButton = document.querySelector(".mobile-menu-button");
      const mobileNav = document.getElementById("mobile-nav");
      mobileButton?.addEventListener("click", () => {
        const expanded = mobileButton.getAttribute("aria-expanded") === "true";
        mobileButton.setAttribute("aria-expanded", String(!expanded));
        if (mobileNav) mobileNav.hidden = expanded;
      });
    </script>
  </body>
</html>