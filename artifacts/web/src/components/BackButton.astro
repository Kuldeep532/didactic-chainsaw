<button class="fixed-back" type="button" aria-label="Go back to the previous page">
  <span aria-hidden="true">←</span>
  <span>Back</span>
</button>
<script>
  const setupBackButton=()=>{
    const button=document.querySelector(".fixed-back");
    if(!button || button.hasAttribute("data-ready")) return;
    button.setAttribute("data-ready","true");
    button.addEventListener("click",()=>{
      if(window.history.length>1){
        window.history.back();
      }else{
        window.location.href="/";
      }
    });
  };
  setupBackButton();
  document.addEventListener("astro:page-load",setupBackButton);
</script>
<style>
  .fixed-back{
    position:fixed;
    left:max(16px,env(safe-area-inset-left));
    bottom:calc(18px + env(safe-area-inset-bottom));
    z-index:80;
    min-width:76px;
    min-height:46px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:10px 14px;
    border:1px solid var(--color-border);
    border-radius:999px;
    background:color-mix(in srgb,var(--color-surface-raised) 94%,transparent);
    color:var(--color-text);
    box-shadow:var(--shadow-2);
    backdrop-filter:blur(12px);
    font:inherit;
    font-weight:750;
    cursor:pointer;
  }
  .fixed-back:hover{background:var(--color-surface-soft);border-color:var(--color-border-strong);transform:translateY(-1px)}
  .fixed-back:focus-visible{outline:3px solid color-mix(in srgb,var(--color-primary) 32%,transparent);outline-offset:3px}
  @media (max-width:639px){.fixed-back{left:max(12px,env(safe-area-inset-left));bottom:calc(12px + env(safe-area-inset-bottom));min-width:70px}}
</style>