---
const type = Astro.props.type ?? "spark";
const title = Astro.props.title ?? "";
const subtitle = Astro.props.subtitle ?? "";
---
<div class:list={["feature-visual", "feature-visual--"+type]} aria-hidden="true">
  <div class="feature-visual__glow"></div>
  <div class="feature-visual__window">
    <span class="feature-visual__topline"></span>
    <div class="feature-visual__grid">
      <i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
    <div class="feature-visual__center">
      <span class="feature-visual__icon"></span>
      <strong>{title}</strong>
      <small>{subtitle}</small>
    </div>
  </div>
</div>
<style>
.feature-visual{position:relative;min-height:190px;display:grid;place-items:center;overflow:hidden;border-radius:22px;background:linear-gradient(145deg,#f8fbff,#eef4ff 52%,#f7efff);border:1px solid rgb(148 163 184 / 24%);contain:paint}
.feature-visual--audio{background:linear-gradient(145deg,#effcf9,#e9f7ff 55%,#edf0ff)}.feature-visual--safety{background:linear-gradient(145deg,#fff5f7,#fff6eb 55%,#f5efff)}.feature-visual--gita{background:linear-gradient(145deg,#fff8e7,#fff2cf 55%,#f5eefe)}.feature-visual--community{background:linear-gradient(145deg,#f4f7ff,#f1edff 52%,#effbff)}
.feature-visual__glow{position:absolute;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgb(37 99 235 / 18%),transparent 65%);filter:blur(3px)}.feature-visual__window{position:relative;width:min(82%,270px);height:140px;padding:13px;border:1px solid rgb(255 255 255 / 85%);border-radius:18px;background:rgb(255 255 255 / 72%);box-shadow:0 10px 24px rgb(15 23 42 / 12%);backdrop-filter:blur(8px);transform:perspective(800px) rotateX(4deg) rotateY(-6deg)}.feature-visual__topline{display:block;width:44%;height:7px;border-radius:999px;background:#cbd5e1}.feature-visual__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.feature-visual__grid i{height:22px;border-radius:7px;background:linear-gradient(135deg,#bfdbfe,#e9d5ff)}.feature-visual__grid i:nth-child(2n){background:linear-gradient(135deg,#bbf7d0,#bfdbfe)}.feature-visual__center{position:absolute;inset:30px 22px 18px;display:grid;place-content:center;text-align:center;gap:4px}.feature-visual__icon{width:38px;height:38px;margin:0 auto;border-radius:14px;background:linear-gradient(135deg,#2563eb,#7c3aed);box-shadow:0 8px 18px rgb(37 99 235 / 22%)}.feature-visual--audio .feature-visual__icon{background:linear-gradient(135deg,#059669,#2563eb)}.feature-visual--safety .feature-visual__icon{background:linear-gradient(135deg,#db2777,#ef4444)}.feature-visual--gita .feature-visual__icon{background:linear-gradient(135deg,#d97706,#7c3aed)}.feature-visual--community .feature-visual__icon{background:linear-gradient(135deg,#4f46e5,#0ea5e9)}.feature-visual__center strong{font-size:13px;color:#172033}.feature-visual__center small{font-size:10px;color:#64748b}.feature-visual__window::after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(110deg,transparent 20%,rgb(255 255 255 / 45%) 42%,transparent 62%);transform:translateX(-130%)}@media (prefers-reduced-motion:no-preference){.feature-visual__window::after{animation:featureSheen 5.5s ease-in-out infinite}.feature-visual__glow{animation:featurePulse 5s ease-in-out infinite}}@keyframes featureSheen{0%,50%{transform:translateX(-130%)}70%,100%{transform:translateX(130%)}}@keyframes featurePulse{50%{transform:scale(1.08);opacity:.78}}@media (prefers-reduced-motion:reduce){.feature-visual__window{transform:none}}
</style>